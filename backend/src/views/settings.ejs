<div class="mb-5">
    <h4 class="mb-1">Platform Protocols</h4>
    <p class="text-muted small mb-0">Adjust global market variables and operational constraints.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5 class="card-title text-primary mb-4">Financial Protocol</h5>
                <hr class="border-secondary opacity-25">

                <form action="/admin/settings" method="POST" class="mt-4">
                    <div class="mb-4">
                        <label class="form-label small fw-bold uppercase ls-1 text-muted">Platform Commission</label>
                        <div class="input-group">
                            <input type="number" step="0.01" name="platform_commission" class="form-control bg-surface border-secondary text-white mono" value="<%= settings.platform_commission %>" required>
                            <span class="input-group-text bg-accent border-secondary text-muted mono">% Decimal</span>
                        </div>
                        <div class="form-text text-muted smaller mt-2">
                            Current extraction: <span class="text-active fw-bold"><%= (parseFloat(settings.platform_commission || 0) * 100).toFixed(0) %>%</span>
                        </div>
                    </div>

                    <h6 class="text-muted small fw-bold uppercase ls-1 mb-3">Fare Pricing Dynamics (NGN)</h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label smaller fw-bold text-muted">Base (SMALL)</label>
                            <input type="number" name="base_fare_small" class="form-control bg-surface border-secondary text-white mono" value="<%= settings.base_fare_small || 500 %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label smaller fw-bold text-muted">Base (MEDIUM)</label>
                            <input type="number" name="base_fare_medium" class="form-control bg-surface border-secondary text-white mono" value="<%= settings.base_fare_medium || 1000 %>" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label smaller fw-bold text-muted">Base (LARGE)</label>
                            <input type="number" name="base_fare_large" class="form-control bg-surface border-secondary text-white mono" value="<%= settings.base_fare_large || 1500 %>" required>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold uppercase ls-1 text-muted">Distance Rate (Per KM)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-accent border-secondary text-muted mono">₦</span>
                            <input type="number" name="per_km_rate" class="form-control bg-surface border-secondary text-white mono" value="<%= settings.per_km_rate || 150 %>" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold ls-1">COMMIT PLATFORM CHANGES</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body p-4">
                <h5 class="card-title text-active mb-4">Core Environment</h5>
                <hr class="border-secondary opacity-25">

                <div class="d-flex flex-column gap-3 mt-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">System Mode</span>
                        <span class="badge bg-success mono">PRODUCTION</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">API Version</span>
                        <span class="mono text-white">v1.2.4-alpha</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Runtime</span>
                        <span class="mono text-white">Node.js <%= process.version %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Storage Layer</span>
                        <span class="mono text-white">PostgreSQL 16.2</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.75rem; }
    .bg-accent { background-color: var(--bg-accent) !important; }
    .bg-surface { background-color: #2C2C2E !important; }
</style>
