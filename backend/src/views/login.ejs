<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Pikop Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #0B0B0B;
            color: white;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .login-form {
            width: 100%;
            max-width: 400px;
            padding: 40px;
            background: #1C1C1E;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            border: 1px solid #333;
        }
        .btn-primary {
            background-color: #FF9F0A;
            border: none;
            font-weight: bold;
            padding: 12px;
        }
        .btn-primary:hover { background-color: #e68a00; }
        .form-control { background-color: #2C2C2E; border: 1px solid #3A3A3C; color: white; }
        .form-control:focus { background-color: #2C2C2E; color: white; border-color: #FF9F0A; box-shadow: none; }
        .brand-logo { width: 150px; margin-bottom: 20px; }
    </style>
</head>
<body>
    <div class="login-form text-center">
        <img src="/public/assets/logo.png" alt="Pikop Logo" class="brand-logo">
        <h3 class="mb-4">Admin Portal</h3>
        <% if (locals.error) { %>
            <div class="alert alert-danger py-2"><small><%= error %></small></div>
        <% } %>
        <form action="/admin/login" method="POST" class="text-start">
            <div class="mb-3">
                <label class="form-label small text-muted">Username</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="mb-4">
                <label class="form-label small text-muted">Password</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">Login to Dashboard</button>
        </form>
        <p class="mt-4 text-muted small">© 2026 Awa Foods & Groceries</p>
    </div>
</body>
</html>
