<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Your Pikop Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #0F172A; color: white; font-family: sans-serif; }
        #map { height: 400px; width: 100%; border-radius: 12px; margin-bottom: 24px; }
        .card { background: #1E293B; border: 1px solid #334155; color: white; border-radius: 12px; }
        .status-badge { padding: 4px 12px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; }
        .bg-orange { background: #FF9F0A; color: #0F172A; }
    </style>
</head>
<body class="p-3 p-md-5">
    <div class="container" style="max-width: 600px;">
        <div class="text-center mb-4">
            <img src="/public/assets/logo.png" alt="Pikop Logo" style="width: 100px;">
            <h4 class="mt-3 fw-bold">Live Mission Tracking</h4>
        </div>

        <% if (locals.error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } else { %>
            <div id="map"></div>

            <div class="card p-4 shadow-lg">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <span class="text-muted small uppercase d-block">Current Status</span>
                        <span class="status-badge bg-orange"><%= order.status.replace(/_/g, ' ') %></span>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Mission Token</span>
                        <code class="text-info"><%= order.token.take(8) %></code>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-6">
                        <span class="text-muted small d-block">Origin</span>
                        <span class="fw-bold"><%= order.pickup_zone %></span>
                    </div>
                    <div class="col-6 text-end">
                        <span class="text-muted small d-block">Destination</span>
                        <span class="fw-bold"><%= order.delivery_zone %></span>
                    </div>
                </div>

                <% if (order.fulfiller) { %>
                    <hr class="border-secondary opacity-25">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary" style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; font-weight: bold;">
                            <%= order.fulfiller.full_name.charAt(0) %>
                        </div>
                        <div>
                            <span class="fw-bold d-block"><%= order.fulfiller.full_name %></span>
                            <span class="text-muted small">
                                <%= order.fulfiller.tier.toUpperCase() %> AGENT
                                <%= order.fulfiller.vehicle_registration_number ? '| ' + order.fulfiller.vehicle_registration_number : '' %>
                            </span>
                        </div>
                    </div>
                <% } %>
            </div>

            <p class="text-center mt-5 text-muted small">© 2026 Pikop Logistics. Delivered with Speed.</p>
        <% } %>
    </div>

    <% if (!locals.error) { %>
        <script src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_MAPS_API_KEY %>"></script>
        <script src="/socket.io/socket.io.js"></script>
        <script>
            const orderToken = "<%= order.token %>";
            const initialLoc = <%- JSON.stringify(order.live_location || {lat: 6.5244, lng: 3.3792}) %>;

            let map, marker;

            function initMap() {
                map = new google.maps.Map(document.getElementById("map"), {
                    center: initialLoc,
                    zoom: 15,
                    styles: [/* Dark mode styles here */]
                });
                marker = new google.maps.Marker({
                    position: initialLoc,
                    map: map,
                    icon: '/public/assets/marker_agent.png'
                });
            }

            const socket = io();
            socket.emit('join_tracking', orderToken);
            socket.on('location_changed', (data) => {
                const newPos = { lat: data.lat, lng: data.lng };
                marker.setPosition(newPos);
                map.panTo(newPos);
            });
            socket.on('status_updated', () => window.location.reload());

            window.onload = initMap;
        </script>
    <% } %>
</body>
</html>
