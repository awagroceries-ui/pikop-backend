<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Track Your Delivery | Pikop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= process.env.GOOGLE_PLACES_API_KEY %>"></script>
    <script src="/socket.io/socket.io.js"></script>
    <style>
        body { background: #F8FAFC; font-family: 'Inter', sans-serif; }
        #map { height: 400px; width: 100%; border-radius: 12px; margin-bottom: 20px; }
        .tracking-card { max-width: 500px; margin: 40px auto; background: white; padding: 24px; border-radius: 16px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        .status-badge { padding: 6px 16px; border-radius: 20px; font-weight: bold; text-transform: uppercase; font-size: 0.75rem; }
        .status-active { background: #E0F2FE; color: #0EA5E9; }
        .fulfiller-card { display: flex; align-items: center; gap: 16px; padding: 16px; background: #F1F5F9; border-radius: 12px; margin-top: 20px; }
        .fulfiller-avatar { width: 48px; height: 48px; background: #0EA5E9; color: white; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <div class="tracking-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Delivery Status</h4>
                <span id="status-badge" class="status-badge status-active"><%= order.status.replace('_', ' ') %></span>
            </div>

            <div id="map"></div>

            <div class="mb-3">
                <label class="text-muted small">Pickup Zone</label>
                <div class="fw-bold"><%= order.pickup_zone %></div>
            </div>
            <div class="mb-4">
                <label class="text-muted small">Delivery Zone</label>
                <div class="fw-bold"><%= order.delivery_zone %></div>
            </div>

            <% if (order.fulfiller) { %>
                <div class="fulfiller-card">
                    <div class="fulfiller-avatar"><%= order.fulfiller.full_name.charAt(0) %></div>
                    <div>
                        <div class="fw-bold"><%= order.fulfiller.full_name %></div>
                        <div class="text-muted small">Fulfiller Agent • ⭐ <%= order.fulfiller.rating_avg %></div>
                    </div>
                </div>
            <% } %>

            <div class="text-center mt-4">
                <img src="/public/assets/logo.png" alt="Pikop" style="width: 80px; opacity: 0.5;">
            </div>
        </div>
    </div>

    <script>
        const orderData = <%- JSON.stringify(order) %>;
        let map, marker;

        function initMap() {
            const initialPos = orderData.live_location || { lat: 6.5244, lng: 3.3792 };
            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 15,
                center: initialPos,
                disableDefaultUI: true
            });

            marker = new google.maps.Marker({
                position: initialPos,
                map: map,
                icon: {
                    path: google.maps.SymbolPath.CIRCLE,
                    scale: 8,
                    fillColor: "#0EA5E9",
                    fillOpacity: 1,
                    strokeWeight: 2,
                    strokeColor: "#FFFFFF"
                }
            });
        }

        const socket = io();
        socket.emit("join_tracking", orderData.token);

        socket.on("location_changed", (data) => {
            const newPos = { lat: data.lat, lng: data.lng };
            marker.setPosition(newPos);
            map.panTo(newPos);
        });

        socket.on("status_updated", (data) => {
            document.getElementById("status-badge").innerText = data.status.replace('_', ' ');
            if (['DELIVERED', 'CANCELLED', 'CLOSED'].includes(data.status)) {
                location.reload(); // Switch to static view
            }
        });

        window.onload = initMap;
    </script>
</body>
</html>
