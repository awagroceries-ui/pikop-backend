<div class="mb-5">
    <h4 class="mb-1">Corporate Accounts</h4>
    <p class="text-muted small mb-0">Manage high-value SME and enterprise partners.</p>
</div>

<div class="card overflow-hidden">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Company</th>
                <th>Billing Email</th>
                <th>Type</th>
                <th>Staff</th>
                <th>Status</th>
                <th class="text-end">Action</th>
            </tr>
        </thead>
        <tbody class="mono">
            <% if (accounts.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        No corporate accounts registered yet.
                    </td>
                </tr>
            <% } %>
            <% accounts.forEach(acc => { %>
                <tr>
                    <td>
                        <div class="fw-bold"><%= acc.company_name %></div>
                        <code class="small text-muted" style="font-size: 0.65rem;"><%= acc.id %></code>
                    </td>
                    <td class="small"><%= acc.billing_email %></td>
                    <td>
                        <span class="badge bg-opacity-10 <%= acc.billing_type === 'direct_debit' ? 'bg-info text-info' : 'bg-primary text-primary' %> border">
                            <%= (acc.billing_type || 'direct_debit').replace('_', ' ') %>
                        </span>
                    </td>
                    <td><%= acc.staff_count %> members</td>
                    <td>
                        <span class="status-badge <%= acc.status === 'active' ? 'status-delivered' : 'status-searching' %>">
                            <%= acc.status %>
                        </span>
                    </td>
                    <td class="text-end">
                        <% if (acc.status !== 'suspended') { %>
                            <form action="/admin/corporate/<%= acc.id %>/suspend" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3">Suspend</button>
                            </form>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
