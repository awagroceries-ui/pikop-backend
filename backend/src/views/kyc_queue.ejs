<div class="mb-5">
    <h4 class="mb-1">Authentication Hub</h4>
    <p class="text-muted small mb-0">Review identity verifications and operational credentials.</p>
</div>

<% if (!locals.fulfillers || fulfillers.length === 0) { %>
    <div class="card p-5 text-center bg-transparent border-dashed" style="border: 2px dashed var(--border);">
        <div class="opacity-25 mb-4">
            <svg width="80" height="80" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="fw-bold">Mission Ready</h3>
        <p class="text-muted">No pending fulfiller authentications. The fleet is fully verified.</p>
        <div class="mt-4">
            <a href="/admin/dashboard" class="btn btn-primary px-4">Return to Command</a>
        </div>
    </div>
<% } else { %>
    <div class="row g-4">
        <% fulfillers.forEach(f => { %>
            <% if (!f) return; %>
            <div class="col-md-12">
                <div class="card p-4">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <h5 class="mb-1 text-active"><%= f.full_name || 'Unnamed' %></h5>
                            <p class="small text-muted mb-0 mono">AGENT_ID: <%= f.fulfiller_id %></p>
                            <p class="small text-muted mb-0"><%= f.email %></p>
                        </div>

                        <div class="col-md-3">
                            <label class="text-muted small uppercase mono d-block mb-2">Identity (Didit)</label>
                            <% if (f.didit_verification_status === 'approved') { %>
                                <span class="status-badge status-delivered">Approved</span>
                            <% } else if (f.didit_verification_status === 'needs_review') { %>
                                <span class="status-badge status-searching">Needs Review</span>
                                <a href="https://business.didit.me/sessions/<%= f.didit_session_id %>" target="_blank" class="small d-block mt-1 text-primary">View on Didit</a>
                            <% } else if (f.didit_verification_status === 'pending') { %>
                                <span class="status-badge status-searching">Processing</span>
                                <form action="/admin/kyc/fulfiller/<%= f.fulfiller_id %>/approve-identity" method="POST" class="mt-2">
                                    <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 0.6rem;">Force Approve</button>
                                </form>
                            <% } else { %>
                                <span class="badge bg-secondary opacity-50">Not Started</span>
                            <% } %>
                        </div>

                        <div class="col-md-4">
                            <label class="text-muted small uppercase mono d-block mb-2">Operational Docs</label>
                            <div class="d-flex gap-2 flex-wrap">
                                <% if (f.documents && Array.isArray(f.documents)) { %>
                                    <% f.documents.forEach(doc => { %>
                                        <div class="position-relative">
                                            <a href="<%= doc.document_url %>" target="_blank" class="badge <%= doc.status === 'APPROVED' ? 'bg-success' : 'bg-warning text-dark' %> text-decoration-none p-2">
                                                <%= (doc.document_type || 'DOC').replace('_', ' ') %>
                                            </a>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <span class="text-muted small italic">None uploaded</span>
                                <% } %>
                            </div>
                        </div>

                        <div class="col-md-2 text-end">
                            <%
                                const docs = (f.documents && Array.isArray(f.documents)) ? f.documents : [];
                                const docsApproved = docs.length > 0 && docs.every(d => d.status === 'APPROVED');
                                const canApprove = f.didit_verification_status === 'approved' && (docsApproved || docs.length === 0);
                            %>
                            <form action="/admin/kyc/fulfiller/<%= f.fulfiller_id %>/verify" method="POST">
                                <button type="submit" class="btn btn-primary w-100 fw-bold" <%= canApprove ? '' : 'disabled' %>>
                                    Final Authorize
                                </button>
                            </form>
                            <% if (!canApprove) { %>
                                <p class="smaller text-muted mt-2">Awaiting all approvals</p>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<style>
    .border-dashed { border-style: dashed !important; }
    .smaller { font-size: 0.65rem; }
</style>
