<div class="mb-5">
    <h4 class="mb-1">Authentication Queue</h4>
    <p class="text-muted small mb-0">Verify new fulfiller credentials for market entry.</p>
</div>

<% if (documents.length === 0) { %>
    <div class="card p-5 text-center bg-transparent border-dashed" style="border: 2px dashed var(--border);">
        <div class="opacity-25 mb-4">
            <svg width="80" height="80" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
        </div>
        <h3 class="fw-bold">All Caught Up</h3>
        <p class="text-muted">There are no pending fulfiller authentications at this time.</p>
        <div class="mt-4">
            <a href="/admin/dashboard" class="btn btn-primary px-4">Return to Command</a>
        </div>
    </div>
<% } else { %>
    <div class="row g-4">
        <% documents.forEach(doc => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 overflow-hidden">
                    <img src="<%= doc.document_url %>" class="card-img-top" alt="KYC Document" style="height: 200px; object-fit: cover; filter: brightness(0.8);">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="mb-1 text-active"><%= doc.full_name %></h5>
                                <span class="badge bg-accent text-muted mono small">ID: <%= doc.fulfiller_id %></span>
                            </div>
                            <span class="status-badge status-searching"><%= doc.document_type.replace('_', ' ') %></span>
                        </div>

                        <p class="text-muted small mb-4">Uploaded: <%= new Date(doc.created_at).toLocaleString() %></p>

                        <div class="d-flex gap-2">
                            <form action="/admin/kyc/<%= doc.id %>/approve" method="POST" class="flex-grow-1">
                                <button type="submit" class="btn btn-success w-100 fw-bold small">Authorize</button>
                            </form>
                            <button class="btn btn-outline-danger small">Reject</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>

<style>
    .border-dashed { border-style: dashed !important; }
</style>
