<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Command | Mission Control</title>
    <!-- Fonts: Inter for UI, JetBrains Mono for Numbers -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-deep: #0F172A;
            --bg-surface: #1E293B;
            --bg-accent: #334155;
            --primary: #FF9F0A;
            --active: #38BDF8;
            --waiting: #FBBF24;
            --critical: #EF4444;
            --text-muted: #E2E8F0; /* Brighter for Mission Control visibility */
            --border: #334155;
        }

        body {
            background-color: var(--bg-deep);
            color: #FFFFFF; /* Absolute white for main text */
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .mono { font-family: 'JetBrains Mono', monospace; font-variant-numeric: tabular-nums; }

        /* Sidebar Styling */
        .sidebar {
            min-height: 100vh;
            background: var(--bg-surface);
            border-right: 1px solid var(--border);
            padding: 0;
            position: fixed;
            width: 240px;
        }

        .sidebar-header {
            padding: 2rem 1.5rem;
            border-bottom: 1px solid var(--border);
        }

        .sidebar a {
            color: #FFFFFF; /* High contrast absolute white links */
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 0.9rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 600;
            transition: 0.2s all ease;
            gap: 12px;
        }

        .sidebar a:hover {
            background: var(--bg-accent);
            color: var(--primary);
        }

        .active-link {
            color: var(--primary) !important;
            background: rgba(255, 159, 10, 0.12);
            border-right: 4px solid var(--primary);
            font-weight: 700;
        }

        /* Content Area */
        .main-wrapper {
            margin-left: 240px;
            padding: 2.5rem;
        }

        .card {
            background-color: var(--bg-surface);
            border: 1px solid var(--border);
            color: #F8FAFC;
            border-radius: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }

        .card-title {
            color: #E2E8F0;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.075em;
            font-weight: 700;
        }

        /* Velocity Pulse Animation */
        @keyframes pulse-critical {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.5); }
            70% { box-shadow: 0 0 0 12px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }

        .pulse-critical {
            animation: pulse-critical 2s infinite;
            border: 1px solid var(--critical);
        }

        /* Status Badges */
        .status-badge {
            padding: 5px 12px;
            border-radius: 9999px;
            font-size: 0.75rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.025em;
        }

        .status-searching { background: rgba(251, 191, 36, 0.15); color: var(--waiting); border: 1px solid var(--waiting); }
        .status-matched { background: rgba(56, 189, 248, 0.15); color: var(--active); border: 1px solid var(--active); }
        .status-delivered { background: rgba(34, 197, 94, 0.15); color: #4ADE80; border: 1px solid #4ADE80; }

        /* Tables */
        .table { color: #F8FAFC; border-color: var(--border); margin: 0; }
        .table thead th {
            background: var(--bg-accent);
            color: #FFFFFF;
            font-size: 0.8rem;
            text-transform: uppercase;
            border: none;
            padding: 14px 1rem;
            font-weight: 800;
        }
        .table tbody td {
            vertical-align: middle;
            border-bottom: 1px solid var(--border);
            padding: 1.25rem 1rem;
        }

        /* High Contrast for muted text in tables */
        .table .text-muted { color: #CBD5E1 !important; }

        /* Scrollbars */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: var(--bg-deep); }
        ::-webkit-scrollbar-thumb { background: var(--bg-accent); border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #475569; }

        @media (prefers-reduced-motion: reduce) {
            * { animation: none !important; transition: none !important; }
        }

        @media (max-width: 992px) {
            .sidebar { width: 80px; text-align: center; }
            .sidebar span, .sidebar h4, .sidebar .sidebar-header { display: none; }
            .main-wrapper { margin-left: 80px; }
            .sidebar a { justify-content: center; padding: 1.5rem 0; }
        }
    </style>
</head>
<body>
    <nav class="sidebar">
        <div class="sidebar-header">
            <img src="/public/assets/logo.png" alt="Logo" style="width: 40px;">
            <div class="mt-3">
                <span class="d-block fw-bold text-white">PIKOP COMMAND</span>
                <span class="text-muted" style="font-size: 0.7rem;">HUB: PORT HARCOURT</span>
            </div>
        </div>
        <div class="mt-4">
            <a href="/admin/dashboard" id="nav-dashboard">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                <span>Overview</span>
            </a>
            <a href="/admin/orders" id="nav-orders">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                <span>Order Board</span>
            </a>
            <a href="/admin/support" id="nav-support">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                <span>Support Inbox</span>
            </a>
            <a href="/admin/withdrawals" id="nav-payouts">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.407 2.67 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.407-2.67-1M12 16V15"></path></svg>
                <span>Financials</span>
            </a>
            <a href="/admin/kyc" id="nav-kyc">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                <span>Fulfiller Auth</span>
            </a>
            <a href="/admin/corporate" id="nav-corporate">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                <span>Corporate Accounts</span>
            </a>
            <% if (locals.role === 'super_admin') { %>
                <a href="/admin/admins" id="nav-admins">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                    <span>Manage Staff</span>
                </a>
                <a href="/admin/settings" id="nav-settings">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <span>Settings</span>
                </a>
            <% } %>
            <div class="mt-auto px-4 py-4" style="position: absolute; bottom: 0; width: 100%;">
                <hr class="border-secondary opacity-25">
                <a href="/admin/logout" class="text-danger">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                    <span>Sign Out</span>
                </a>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <header class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="h3 fw-bold mb-0">Operational Dashboard</h1>
                <p class="text-muted small mb-0">System status: <span class="text-success mono">● NOMINAL</span></p>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div class="text-end">
                    <div class="fw-bold"><%= locals.admin || 'Admin' %></div>
                    <div class="text-muted small uppercase mono"><%= locals.role || 'Access Restricted' %></div>
                </div>
                <div class="rounded-circle bg-accent" style="width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border);">
                    <%= (locals.admin || 'A').charAt(0).toUpperCase() %>
                </div>
            </div>
        </header>

        <main>
            <%- body %>
        </main>
    </div>

    <script>
        // Set active link based on URL
        const path = window.location.pathname;
        if (path.includes('dashboard')) document.getElementById('nav-dashboard').classList.add('active-link');
        if (path.includes('orders')) document.getElementById('nav-orders').classList.add('active-link');
        if (path.includes('support')) document.getElementById('nav-support').classList.add('active-link');
        if (path.includes('withdrawals')) document.getElementById('nav-payouts').classList.add('active-link');
        if (path.includes('kyc')) document.getElementById('nav-kyc').classList.add('active-link');
        if (path.includes('corporate')) document.getElementById('nav-corporate').classList.add('active-link');
        if (path.includes('admins')) document.getElementById('nav-admins').classList.add('active-link');
        if (path.includes('settings')) document.getElementById('nav-settings').classList.add('active-link');
    </script>
</body>
</html>
