<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #0B0B0B; color: white; font-family: 'Segoe UI', sans-serif; }
        .sidebar { min-height: 100vh; background: #1C1C1E; border-right: 1px solid #333; }
        .sidebar a { color: #8E8E93; text-decoration: none; display: block; padding: 12px 20px; font-size: 0.9rem; transition: 0.3s; }
        .sidebar a:hover { background: #2C2C2E; color: #FF9F0A; }
        .active-link { color: #FF9F0A !important; font-weight: bold; background: rgba(255, 159, 10, 0.1); border-left: 4px solid #FF9F0A; }
        .main-content { background-color: #0B0B0B; }
        .card { background-color: #1C1C1E; border: 1px solid #333; color: white; }
        .navbar-brand img { width: 40px; margin-right: 10px; }
        .text-primary { color: #FF9F0A !important; }
        .btn-primary { background-color: #FF9F0A; border: none; }
        .table { color: white; border-color: #333; }
        .table thead { background-color: #2C2C2E; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar">
                <div class="sidebar-sticky pt-3">
                    <div class="px-3 mb-4 text-center">
                        <img src="/public/assets/logo.png" alt="Logo" style="width: 80px;">
                        <h5 class="mt-2 text-primary">Pikop Admin</h5>
                    </div>
                    <ul class="nav flex-column">
                        <li><a href="/admin/dashboard">Dashboard</a></li>
                        <li><a href="/admin/orders">Order Board</a></li>
                        <li><a href="/admin/withdrawals">Withdrawals</a></li>
                        <li><a href="/admin/kyc">KYC Queue</a></li>
                        <li><a href="/admin/settings">Settings</a></li>
                        <li><a href="/admin/zones">Zones & Pricing</a></li>
                        <li><a href="/admin/disputes">Disputes</a></li>
                        <li><hr class="border-secondary"></li>
                        <li><a href="/admin/logout" class="text-danger">Logout</a></li>
                    </ul>
                </div>
            </nav>

            <main class="col-md-10 ms-sm-auto main-content px-md-4 py-4">
                <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom border-secondary">
                    <h1 class="h2">Management Console</h1>
                    <div class="small">Admin: <span class="text-primary"><%= admin %></span></div>
                </div>
                <%- body %>
            </main>
        </div>
    </div>
</body>
</html>
