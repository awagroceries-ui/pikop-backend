<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tracking Update | Pikop</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #F8FAFC; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .card { max-width: 400px; width: 90%; padding: 40px; text-align: center; border-radius: 24px; border: none; box-shadow: 0 10px 40px rgba(0,0,0,0.05); }
        .icon { font-size: 64px; margin-bottom: 24px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="icon">📦</div>
        <h4 class="mb-3">Tracking Update</h4>
        <p class="text-muted"><%= message %></p>
        <hr class="my-4 opacity-10">
        <img src="/public/assets/logo.png" alt="Pikop" style="width: 80px; opacity: 0.5;">
    </div>
</body>
</html>
