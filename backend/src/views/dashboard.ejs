<!-- 1. KPI Tile Row -->
<div class="row g-4 mb-5">
    <!-- Revenue KPI -->
    <div class="col-md-3">
        <div class="card p-4 border-0 h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="avatar-circle" style="background: rgba(255, 159, 10, 0.1); color: var(--brand-gold);">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.407 2.67 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.407-2.67-1M12 16V15"></path></svg>
                </div>
                <div class="text-success small fw-extrabold mono">+12% <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 10l7-7m0 0l7 7m-7-7v18"></path></svg></div>
            </div>
            <h6 class="text-muted smaller fw-bold uppercase ls-1 mb-1">Gross Yield</h6>
            <div class="fs-2 fw-extrabold mono" id="kpi-revenue">₦<%= Number(stats.totalRevenue).toLocaleString() %></div>
            <div class="mt-4" style="height: 40px;">
                <canvas id="sparkline-revenue"></canvas>
            </div>
        </div>
    </div>

    <!-- Active Missions KPI -->
    <div class="col-md-3">
        <div class="card p-4 border-0 h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="avatar-circle" style="background: rgba(255, 87, 34, 0.1); color: var(--brand-orange);">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                </div>
                <div class="text-success small fw-extrabold mono">+5.4%</div>
            </div>
            <h6 class="text-muted smaller fw-bold uppercase ls-1 mb-1">Live Missions</h6>
            <div class="fs-2 fw-extrabold mono" id="kpi-missions"><%= stats.activeOrders %></div>
            <div class="mt-4" style="height: 40px;">
                <canvas id="sparkline-missions"></canvas>
            </div>
        </div>
    </div>

    <!-- Active Fleet KPI -->
    <div class="col-md-3">
        <div class="card p-4 border-0 h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="avatar-circle" style="background: rgba(139, 195, 74, 0.1); color: var(--brand-green);">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                </div>
                <div class="text-danger small fw-extrabold mono">-2.1%</div>
            </div>
            <h6 class="text-muted smaller fw-bold uppercase ls-1 mb-1">Fleet Online</h6>
            <div class="fs-2 fw-extrabold mono" id="kpi-fleet"><%= stats.onlineFulfillers %></div>
            <div class="mt-4" style="height: 40px;">
                <canvas id="sparkline-fleet"></canvas>
            </div>
        </div>
    </div>

    <!-- Success Rate KPI -->
    <div class="col-md-3">
        <div class="card p-4 border-0 h-100">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div class="avatar-circle" style="background: rgba(56, 189, 248, 0.1); color: #0EA5E9;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <div class="text-success small fw-extrabold mono">98.5%</div>
            </div>
            <h6 class="text-muted smaller fw-bold uppercase ls-1 mb-1">Success Rate</h6>
            <div class="fs-2 fw-extrabold mono">94.2%</div>
            <div class="mt-4" style="height: 40px;">
                <canvas id="sparkline-success"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 2. Fulfiller Class Performance Cards -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="fw-extrabold ls-1 mb-0">Fulfiller Performance by Class</h5>
    <div class="btn-group btn-group-sm bg-white shadow-sm rounded-pill p-1">
        <button class="btn btn-dark rounded-pill px-3 py-1" onclick="updateRange(7)">7D</button>
        <button class="btn text-muted px-3 py-1" onclick="updateRange(30)">30D</button>
        <button class="btn text-muted px-3 py-1" onclick="updateRange(90)">90D</button>
    </div>
</div>

<div class="row g-4 mb-5" id="class-performance-grid">
    <% ['agent', 'rider', 'driver'].forEach(c => {
        const data = stats.classPerformance.find(p => p.primary_class === c) || { revenue: 0, order_count: 0, avg_rating: 5.0 };
    %>
    <div class="col-md-3">
        <div class="card p-4 border-top border-4 shadow-sm" style="border-top-color: var(--brand-gold) !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-light text-dark fw-bold uppercase" style="font-size: 0.6rem;"><%= c %></span>
                <span class="mono fw-bold" style="color: var(--brand-gold);">★ <%= Number(data.avg_rating).toFixed(1) %></span>
            </div>
            <div class="text-muted smaller fw-bold uppercase ls-1 mb-1">Revenue</div>
            <div class="fs-4 fw-extrabold mono mb-4">₦<%= Number(data.revenue).toLocaleString() %></div>
            <div class="d-flex justify-content-between border-top pt-3">
                <span class="text-muted small">Completed</span>
                <span class="fw-bold mono small"><%= data.order_count %></span>
            </div>
        </div>
    </div>
    <% }) %>

    <!-- Platform Total (Adaptation of Reference's Gradient Balance) -->
    <div class="col-md-3">
        <div class="card p-4 border-0 text-white shadow-lg" style="background: linear-gradient(135deg, var(--brand-black) 0%, #1c1c1c 100%);">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-warning text-dark fw-bold uppercase" style="font-size: 0.6rem;">Platform</span>
                <div class="rounded-circle" style="width: 8px; height: 8px; background: var(--brand-green); box-shadow: 0 0 10px var(--brand-green);"></div>
            </div>
            <div class="text-white-50 smaller fw-bold uppercase ls-1 mb-1">Net Earnings</div>
            <div class="fs-4 fw-extrabold mono mb-4 text-white">₦<%= Number(stats.totalRevenue * 0.25).toLocaleString() %></div>
            <div class="d-flex justify-content-between border-top border-white border-opacity-10 pt-3">
                <span class="text-white-50 small">Fee (25%)</span>
                <span class="fw-bold mono small text-primary">₦<%= Number(stats.totalRevenue * 0.25).toLocaleString() %></span>
            </div>
        </div>
    </div>
</div>

<!-- 3. Two-Panel Section: Pending Queues -->
<div class="row g-4 mb-5">
    <!-- Pending Approvals Widget -->
    <div class="col-md-6">
        <div class="card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-extrabold ls-1 uppercase smaller">Fleet Approvals Pending</h6>
                <select class="form-select form-select-sm border-0 bg-light mono text-muted" style="width: auto; font-size: 0.7rem;">
                    <option>Onboarding (KYC)</option>
                </select>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <div class="fs-1 fw-extrabold mono"><%= stats.notifications.kyc %></div>
                        <div class="text-muted small">Verification applications awaiting review</div>
                    </div>
                    <a href="/admin/kyc" class="btn btn-lg shadow-sm" style="background: var(--brand-gold); color: var(--brand-black); border-radius: 12px; font-weight: 800; font-size: 0.85rem;">
                        Open Queue
                    </a>
                </div>
                <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3">
                    <div class="avatar-circle" style="background: rgba(0,0,0,0.05); width: 32px; height: 32px; font-size: 0.7rem;">⚡</div>
                    <span class="text-muted small">System avg: <span class="text-dark fw-bold">14 mins</span> per audit.</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Disputes Widget -->
    <div class="col-md-6">
        <div class="card border-0 h-100 shadow-sm">
            <div class="card-header bg-transparent border-0 p-4 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-extrabold ls-1 uppercase smaller">Active Incidents / Disputes</h6>
                <select class="form-select form-select-sm border-0 bg-light mono text-muted" style="width: auto; font-size: 0.7rem;">
                    <option>All Categories</option>
                </select>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <div class="fs-1 fw-extrabold mono text-danger"><%= stats.notifications.disputes %></div>
                        <div class="text-muted small">High-priority unresolved mission flags</div>
                    </div>
                    <a href="/admin/disputes" class="btn btn-lg btn-outline-danger shadow-sm" style="border-radius: 12px; font-weight: 800; font-size: 0.85rem;">
                        Resolve Now
                    </a>
                </div>
                <div class="p-3 rounded-3 d-flex align-items-center gap-3" style="background: rgba(239, 68, 68, 0.05);">
                    <div class="avatar-circle" style="background: rgba(239, 68, 68, 0.1); color: #EF4444; width: 32px; height: 32px; font-size: 0.7rem;">!</div>
                    <span class="text-danger small fw-bold">Critical: <span class="mono">0</span> items open > 24 hours.</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 4. Real-time Charts Section -->
<div class="row g-4">
    <!-- Volume Trend Panel -->
    <div class="col-md-8">
        <div class="card border-0 p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-5">
                <div>
                    <h6 class="fw-extrabold ls-1 uppercase smaller mb-1">Mission Volume & Yield</h6>
                    <p class="text-muted small mb-0">Platform performance trend over 30 days.</p>
                </div>
                <div class="header-actions" style="color: var(--text-muted);">
                    <div class="d-flex align-items-center gap-2 small fw-bold"><div class="rounded-circle" style="width: 8px; height: 8px; background: var(--brand-gold);"></div> Revenue</div>
                    <div class="d-flex align-items-center gap-2 small fw-bold"><div class="rounded-circle" style="width: 8px; height: 8px; background: #0EA5E9;"></div> Missions</div>
                </div>
            </div>
            <div style="height: 350px;">
                <canvas id="chart-volume-trend"></canvas>
            </div>
        </div>
    </div>

    <!-- Status Breakdown Panel -->
    <div class="col-md-4">
        <div class="card border-0 p-4 shadow-sm">
            <h6 class="fw-extrabold ls-1 uppercase smaller mb-5">Mission Status Mix</h6>
            <div style="height: 250px;">
                <canvas id="chart-status-mix"></canvas>
            </div>
            <div class="mt-5 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="text-muted smaller fw-bold uppercase">System Velocity</span>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold mono">NOMINAL</span>
                </div>
                <div class="d-flex justify-content-between smaller mb-2">
                    <span class="text-muted">Platform Conversion</span>
                    <span class="fw-bold mono text-dark">94.2%</span>
                </div>
                <div class="progress bg-light" style="height: 6px; border-radius: 10px;">
                    <div class="progress-bar" style="width: 94.2%; background: var(--brand-green); border-radius: 10px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    Chart.defaults.font.family = "'Inter', sans-serif";
    Chart.defaults.color = '#94A3B8';

    // 1. Volume & Revenue Trend Chart
    const trendCtx = document.getElementById('chart-volume-trend').getContext('2d');
    const revGradient = trendCtx.createLinearGradient(0, 0, 0, 350);
    revGradient.addColorStop(0, 'rgba(255, 159, 10, 0.15)');
    revGradient.addColorStop(1, 'rgba(255, 159, 10, 0)');

    const trendChart = new Chart(trendCtx, {
        type: 'line',
        data: {
            labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6', 'Week 7'],
            datasets: [
                {
                    label: 'Revenue',
                    data: <%= JSON.stringify(stats.revenueTrend) %>,
                    borderColor: '#FF9F0A',
                    backgroundColor: revGradient,
                    fill: true,
                    tension: 0.45,
                    borderWidth: 4,
                    pointRadius: 0,
                    pointHoverRadius: 6,
                    yAxisID: 'y'
                },
                {
                    label: 'Missions',
                    data: [12, 18, 15, 25, 22, 30, 28],
                    borderColor: '#0EA5E9',
                    fill: false,
                    tension: 0.45,
                    borderWidth: 2,
                    borderDash: [5, 5],
                    pointRadius: 0,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
            scales: {
                x: { grid: { display: false }, border: { display: false } },
                y: { beginAtZero: true, grid: { color: '#F1F5F9' }, border: { display: false }, ticks: { callback: v => '₦' + v.toLocaleString() } },
                y1: { position: 'right', grid: { display: false }, border: { display: false } }
            }
        }
    });

    // 2. Status Mix Ring Chart
    new Chart(document.getElementById('chart-status-mix'), {
        type: 'doughnut',
        data: {
            labels: ['Delivered', 'Cancelled', 'Active'],
            datasets: [{
                data: [82, 6, 12],
                backgroundColor: ['#8BC34A', '#FF5722', '#FF9F0A'],
                borderWidth: 0,
                hoverOffset: 12
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '82%',
            plugins: {
                legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, padding: 30, font: { weight: 'bold', size: 11 } } }
            }
        }
    });

    // 3. Mini Sparklines
    function initSpark(id, data, color) {
        new Chart(document.getElementById(id), {
            type: 'line',
            data: {
                labels: new Array(data.length).fill(''),
                datasets: [{ data: data, borderColor: color, borderWidth: 2.5, fill: false, pointRadius: 0, tension: 0.45 }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { enabled: false } },
                scales: { x: { display: false }, y: { display: false } }
            }
        });
    }

    initSpark('sparkline-revenue', <%= JSON.stringify(stats.revenueTrend) %>, '#FF9F0A');
    initSpark('sparkline-missions', [4, 8, 6, 10, 8, 12, 9], '#FF5722');
    initSpark('sparkline-fleet', [12, 10, 14, 11, 15, 13, <%= stats.onlineFulfillers %>], '#8BC34A');
    initSpark('sparkline-success', [95, 96, 94, 98, 97, 95, 94], '#0EA5E9');

    async function updateRange(days) {
        const res = await fetch(`/admin/metrics?range=${days}`);
        const data = await res.json();

        // Update KPIs
        document.getElementById('kpi-revenue').innerText = '₦' + Number(data.revenue.gross).toLocaleString();
        document.getElementById('kpi-missions').innerText = data.active_orders;

        // Update Class Performance UI
        const grid = document.getElementById('class-performance-grid');
        // Redraw or update existing elements...
    }
</script>
