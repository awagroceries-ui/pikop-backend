<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin/support" class="text-muted">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h4 class="mb-0">Session with <%= conversation.participant_name %></h4>
            <span class="text-muted small mono">CONV_ID: <%= conversation.id %></span>
        </div>
    </div>
    <form action="/admin/support/<%= conversation.id %>/resolve" method="POST">
        <button type="submit" class="btn btn-sm btn-outline-success px-4 fw-bold">Close Session</button>
    </form>
</div>

<div class="card d-flex flex-column" style="height: 60vh;">
    <div id="chat-window" class="card-body overflow-auto p-4 d-flex flex-column gap-3" style="background: var(--bg-deep);">
        <% messages.forEach(msg => { %>
            <div class="d-flex <%= msg.sender_type === 'ADMIN' ? 'justify-content-end' : 'justify-content-start' %>">
                <div class="p-3 rounded-3" style="max-width: 70%; background: <%= msg.sender_type === 'ADMIN' ? 'var(--primary)' : 'var(--bg-accent)' %>; color: <%= msg.sender_type === 'ADMIN' ? '#0B0B0B' : 'white' %>;">
                    <p class="mb-1 small"><%= msg.content %></p>
                    <div class="text-end" style="font-size: 0.65rem; opacity: 0.6;">
                        <%= new Date(msg.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
    <div class="card-footer p-3 border-secondary">
        <div class="input-group">
            <input type="text" id="msg-input" class="form-control bg-dark border-secondary text-white" placeholder="Type your response...">
            <button class="btn btn-primary px-4 fw-bold" id="send-btn">Transmit</button>
        </div>
    </div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
    const socket = io();
    const convId = "<%= conversation.id %>";
    const adminId = "<%= adminId %>";
    const chatWindow = document.getElementById('chat-window');
    const msgInput = document.getElementById('msg-input');
    const sendBtn = document.getElementById('send-btn');

    socket.emit('join_support', convId);

    socket.on('new_message', (msg) => {
        appendMessage(msg);
        chatWindow.scrollTop = chatWindow.scrollHeight;
    });

    function appendMessage(msg) {
        const isMe = msg.senderType === 'ADMIN';
        const div = document.createElement('div');
        div.className = `d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'}`;
        div.innerHTML = `
            <div class="p-3 rounded-3" style="max-width: 70%; background: ${isMe ? 'var(--primary)' : 'var(--bg-accent)'}; color: ${isMe ? '#0B0B0B' : 'white'};">
                <p class="mb-1 small">${msg.content}</p>
                <div class="text-end" style="font-size: 0.65rem; opacity: 0.6;">Now</div>
            </div>
        `;
        chatWindow.appendChild(div);
    }

    sendBtn.onclick = () => {
        const content = msgInput.value.trim();
        if (!content) return;

        socket.emit('send_message', {
            conversationId: convId,
            senderId: adminId,
            senderType: 'ADMIN',
            content: content
        });

        msgInput.value = '';
    };

    msgInput.onkeypress = (e) => {
        if (e.key === 'Enter') sendBtn.click();
    };

    // Auto-scroll on load
    chatWindow.scrollTop = chatWindow.scrollHeight;
</script>
