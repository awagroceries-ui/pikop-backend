<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h4 class="mb-1">Access Control</h4>
        <p class="text-muted small mb-0">Manage administrative staff and system permissions.</p>
    </div>
    <button class="btn btn-primary fw-bold px-4" data-bs-toggle="modal" data-bs-target="#addAdminModal">
        Deploy New Agent
    </button>
</div>

<div class="card overflow-hidden">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Username</th>
                <th>Privilege Role</th>
                <th>Service Since</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody class="mono">
            <% admins.forEach(usr => { %>
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-accent" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;">
                                <%= usr.username.charAt(0).toUpperCase() %>
                            </div>
                            <span><%= usr.username %></span>
                        </div>
                    </td>
                    <td>
                        <span class="badge bg-opacity-10 <%= usr.role === 'super_admin' ? 'bg-primary text-primary border border-primary' : 'bg-info text-active border border-info' %>">
                            <%= usr.role.replace('_', ' ').toUpperCase() %>
                        </span>
                    </td>
                    <td class="text-muted small">
                        <%= new Date(usr.created_at).toLocaleDateString() %>
                    </td>
                    <td class="text-end">
                        <% if (usr.id !== locals.adminId) { %>
                            <form action="/admin/admins/<%= usr.id %>/delete" method="POST" onsubmit="return confirm('Revoke access for this agent?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger border-0">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                                </button>
                            </form>
                        <% } else { %>
                            <span class="badge bg-secondary opacity-25">CURRENT SESSION</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<!-- Add Admin Modal -->
<div class="modal fade" id="addAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card shadow-lg">
            <div class="modal-header border-secondary">
                <h5 class="modal-title">Authorize New Agent</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/admin/admins" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label small text-muted">Official Email/Username</label>
                        <input type="text" name="username" class="form-control bg-dark border-secondary text-white" required placeholder="e.g. ops.manager@pikop.ng">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Secure Access Key</label>
                        <input type="password" name="password" class="form-control bg-dark border-secondary text-white" required minlength="6">
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted">Permission Level</label>
                        <select name="role" class="form-select bg-dark border-secondary text-white" required>
                            <option value="ops">Ops (Logistics & KYC)</option>
                            <option value="finance">Finance (Ledger & Payouts)</option>
                            <option value="support">Support (Disputes)</option>
                            <option value="super_admin">Super Admin (Full Protocols)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Deploy Account</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
