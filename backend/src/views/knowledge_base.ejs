<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h4 class="mb-1 fw-extrabold ls-1">Knowledge Base</h4>
        <p class="text-muted small mb-0">Manage FAQ articles and help documentation for apps.</p>
    </div>
    <button class="btn btn-primary fw-bold" data-bs-toggle="modal" data-bs-target="#createKBModal">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" class="me-2"><path d="M12 4v16m8-8H4"></path></svg>
        New Article
    </button>
</div>

<div class="row g-4">
    <% if (articles.length === 0) { %>
        <div class="col-12">
            <div class="card p-5 text-center bg-transparent border-dashed" style="border: 2px dashed var(--border);">
                <p class="text-muted mb-0">No articles found. Start by creating your first FAQ.</p>
            </div>
        </div>
    <% } else { %>
        <% articles.forEach(article => { %>
            <div class="col-md-12">
                <div class="card p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar-circle" style="background: rgba(255, 159, 10, 0.1); color: var(--brand-gold); width: 40px; height: 40px; font-size: 0.8rem;">
                                    <%= article.priority %>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold"><%= article.title %></h6>
                                    <span class="badge bg-light text-dark uppercase smaller" style="font-size: 0.6rem;"><%= article.category %></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 text-center">
                            <span class="badge <%= article.target_audience === 'CUSTOMER' ? 'bg-info' : (article.target_audience === 'FULFILLER' ? 'bg-primary' : 'bg-dark') %> smaller">
                                <%= article.target_audience %>
                            </span>
                        </div>
                        <div class="col-md-2 text-center">
                            <% if (article.is_active) { %>
                                <span class="status-pill" style="background: rgba(139, 195, 74, 0.1); color: var(--brand-green);">Active</span>
                            <% } else { %>
                                <span class="status-pill bg-light text-muted">Draft</span>
                            <% } %>
                        </div>
                        <div class="col-md-4 text-end">
                            <button class="btn btn-sm btn-outline-secondary px-3" data-bs-toggle="modal" data-bs-target="#editKBModal<%= article.id.replace(/-/g, '') %>">Edit</button>
                            <form action="/admin/kb/<%= article.id %>/delete" method="POST" class="d-inline ms-2" onsubmit="return confirm('Are you sure you want to delete this article?')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Edit Modal -->
            <div class="modal fade" id="editKBModal<%= article.id.replace(/-/g, '') %>" tabindex="-1">
                <div class="modal-dialog modal-lg">
                    <form action="/admin/kb/<%= article.id %>" method="POST" class="modal-content">
                        <div class="modal-header border-0 p-4">
                            <h5 class="modal-title fw-bold">Edit Article</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4 pt-0">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted uppercase ls-1">Title</label>
                                <input type="text" name="title" class="form-control" value="<%= article.title %>" required>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted uppercase ls-1">Category</label>
                                    <input type="text" name="category" class="form-control" value="<%= article.category %>" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted uppercase ls-1">Target Audience</label>
                                    <select name="target_audience" class="form-select">
                                        <option value="CUSTOMER" <%= article.target_audience === 'CUSTOMER' ? 'selected' : '' %>>Sender (Customer)</option>
                                        <option value="FULFILLER" <%= article.target_audience === 'FULFILLER' ? 'selected' : '' %>>Fleet (Fulfiller)</option>
                                        <option value="BOTH" <%= article.target_audience === 'BOTH' ? 'selected' : '' %>>Both</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-bold text-muted uppercase ls-1">Priority (0-10)</label>
                                    <input type="number" name="priority" class="form-control" value="<%= article.priority %>">
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted uppercase ls-1">Content (Markdown supported)</label>
                                <textarea name="content" class="form-control" rows="8" required><%= article.content %></textarea>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" name="is_active" <%= article.is_active ? 'checked' : '' %>>
                                <label class="form-check-label small fw-bold text-muted">Visible in Apps</label>
                            </div>
                        </div>
                        <div class="modal-footer border-0 p-4">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createKBModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <form action="/admin/kb" method="POST" class="modal-content">
            <div class="modal-header border-0 p-4">
                <h5 class="modal-title fw-bold">New Help Article</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted uppercase ls-1">Title</label>
                    <input type="text" name="title" class="form-control" placeholder="e.g. How to track my order?" required>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted uppercase ls-1">Category</label>
                        <select name="category" class="form-select">
                            <option value="General">General</option>
                            <option value="Payments">Payments</option>
                            <option value="Missions">Missions</option>
                            <option value="Account">Account</option>
                            <option value="Safety">Safety</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted uppercase ls-1">Target Audience</label>
                        <select name="target_audience" class="form-select">
                            <option value="CUSTOMER">Sender (Customer)</option>
                            <option value="FULFILLER">Fleet (Fulfiller)</option>
                            <option value="BOTH">Both</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted uppercase ls-1">Priority (0-10)</label>
                        <input type="number" name="priority" class="form-control" value="0">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted uppercase ls-1">Content</label>
                    <textarea name="content" class="form-control" rows="8" placeholder="Detailed answer or instructions..." required></textarea>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="is_active" checked>
                    <label class="form-check-label small fw-bold text-muted">Visible in Apps</label>
                </div>
            </div>
            <div class="modal-footer border-0 p-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary px-4 fw-bold">Create Article</button>
            </div>
        </form>
    </div>
</div>

<style>
    .border-dashed { border-style: dashed !important; }
</style>
