<div class="mb-5">
    <h4 class="mb-1">Payout Ledger</h4>
    <p class="text-muted small mb-0">Authorize market revenue distributions to fulfiller bank accounts.</p>
</div>

<div class="card overflow-hidden">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th>Agent</th>
                <th class="text-end">Disbursement</th>
                <th>Status</th>
                <th>Payment Route</th>
                <th>Created</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody class="mono">
            <% if (withdrawals.length === 0) { %>
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        No payout requests in the current ledger.
                    </td>
                </tr>
            <% } %>
            <% withdrawals.forEach(wd => { %>
                <tr>
                    <td>
                        <div class="fw-bold"><%= wd.full_name %></div>
                        <div class="text-muted small" style="font-size: 0.65rem;">Fulfiller ID: <%= wd.fulfiller_id %></div>
                    </td>
                    <td class="text-end fw-bold text-success">
                        ₦<%= Number(wd.amount).toLocaleString() %>
                    </td>
                    <td>
                        <% if (wd.status === 'SUCCESSFUL') { %>
                            <span class="status-badge status-delivered">Settled</span>
                        <% } else if (wd.status === 'PENDING') { %>
                            <span class="status-badge status-searching">Pending</span>
                        <% } else { %>
                            <span class="badge bg-danger opacity-75"><%= wd.status %></span>
                        <% } %>
                    </td>
                    <td>
                        <div class="small text-muted">Paystack Ref:</div>
                        <code class="small text-active"><%= wd.paystack_reference %></code>
                    </td>
                    <td class="text-muted small">
                        <%= new Date(wd.created_at).toLocaleDateString() %>
                    </td>
                    <td>
                        <% if (wd.status === 'PENDING') { %>
                            <button class="btn btn-sm btn-primary px-3">Execute Transfer</button>
                        <% } else { %>
                            <span class="text-muted opacity-50 small">—</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
