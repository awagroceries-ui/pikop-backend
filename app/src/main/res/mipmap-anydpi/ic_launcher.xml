<?xml version="1.0" encoding="utf-8"?>
<!-- v4.5 fix (#9): pointed at the default Android Studio template layers
     (green grid background + generic robot-ish foreground), never
     replaced with the real Pikop branding. Now uses the actual brand
     background color and the padded, safe-zone-fit Pikop logo mark.
     Dropped the `monochrome` layer: Android 13+ themed icons render it
     using ONLY its alpha channel (the same gotcha fixed for the
     notification icon in PikopMessagingService.kt), and our foreground
     here is a full-color opaque bitmap, not an alpha mask, so declaring
     it as monochrome would render as a solid blob under a themed icon
     pack. Omitting it just means Android 13+ falls back to the normal
     full-color icon instead of a themed one, which is correct for now. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/pikop_launcher_foreground" />
</adaptive-icon>
