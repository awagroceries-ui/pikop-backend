PORT=3000
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/pikop
JWT_SECRET=your_jwt_secret
REFRESH_TOKEN_SECRET=your_refresh_secret
NODE_ENV=production

# SMTP (Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
EMAIL_FROM=awagroceries@gmail.com

# Master OTP for Testing
MASTER_OTP=123456

# Didit Identity Verification
DIDIT_API_KEY=your_didit_api_key
DIDIT_WEBHOOK_SECRET=your_didit_secret

# Google Places API (for Bolt/Uber style Autocomplete)
GOOGLE_PLACES_API_KEY=your_google_places_key

# Gemini API Key (v3 Stable)
GEMINI_API_KEY=your_gemini_key

# Prembly (Identitypass)
PREMBLY_SECRET_KEY=your_prembly_secret
PRIMARY_KYC_PROVIDER=prembly

# Dojah (Fallback)
DOJAH_SECRET_KEY=your_dojah_secret
DOJAH_APP_ID=your_dojah_app_id

# Paystack (Live Keys)
PAYSTACK_SECRET_KEY=your_paystack_secret
PAYSTACK_PUBLIC_KEY=your_paystack_public
