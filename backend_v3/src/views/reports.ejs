<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h4 class="fw-bold mb-1 text-white">Management Reports</h4>
        <p class="text-white opacity-50 small mb-0">Aggregate performance across all business units.</p>
    </div>
    <a href="/admin/reports/export/missions" class="btn-pikop-outline py-2 px-3 ls-1">
        EXPORT MISSIONS (CSV)
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-pikop p-4 h-100">
            <h6 class="text-white small fw-bold uppercase mb-4" style="letter-spacing: 1px;">Revenue Share (GMV)</h6>
            <div style="position: relative; height: 250px; width: 100%;">
                <canvas id="gmvPieChart"></canvas>
            </div>
            <div class="mt-4">
                <table class="table-pikop">
                    <tbody>
                        <% moduleStats.forEach(stat => { %>
                            <tr>
                                <td class="text-white opacity-75 small uppercase fw-bold"><%= stat.order_type.replace('_', ' ') %></td>
                                <td class="text-end fw-bold text-white">₦<%= parseFloat(stat.gmv || 0).toLocaleString() %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-pikop p-4 h-100">
            <h6 class="text-white small fw-bold uppercase mb-4" style="letter-spacing: 1px;">User Engagement</h6>
            <div class="row g-3 mb-4">
                <div class="col-6">
                    <div class="p-3 bg-black border border-white border-opacity-10">
                        <span class="text-white opacity-50 smaller fw-bold d-block mb-1">DAU (24H)</span>
                        <h4 class="mb-0 fw-bold text-white" id="val-dau">...</h4>
                    </div>
                </div>
                <div class="col-6">
                    <div class="p-3 bg-black border border-white border-opacity-10">
                        <span class="text-white opacity-50 smaller fw-bold d-block mb-1">FLEET (24H)</span>
                        <h4 class="mb-0 fw-bold text-white" id="val-fleet">...</h4>
                    </div>
                </div>
            </div>
            <div style="position: relative; height: 180px; width: 100%;">
                <canvas id="userTrendChart"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="card-pikop p-4">
            <h6 class="text-white small fw-bold uppercase mb-4" style="letter-spacing: 1px;">Market Density by Region</h6>
            <div class="row g-4 align-items-center">
                <div class="col-md-8">
                    <div style="position: relative; height: 300px; width: 100%;">
                        <canvas id="cityDensityChart"></canvas>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="d-flex flex-column gap-2">
                        <% cityStats.forEach(city => { %>
                            <div class="p-3 border border-white border-opacity-10 d-flex justify-content-between bg-black">
                                <span class="fw-bold text-white uppercase" style="font-size: 12px;"><%= city.city %></span>
                                <span class="badge bg-gold text-black fw-bold"><%= city.count %> Partners</span>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const gmvCtx = document.getElementById('gmvPieChart').getContext('2d');
    new Chart(gmvCtx, {
        type: 'doughnut',
        data: {
            labels: ['Logistics', 'Marketplace', 'Foods'],
            datasets: [{
                data: [
                    <%= moduleStats.find(s => s.order_type === 'pickup_delivery')?.gmv || 0 %>,
                    <%= moduleStats.find(s => s.order_type === 'marketplace')?.gmv || 0 %>,
                    <%= moduleStats.find(s => s.order_type === 'food')?.gmv || 0 %>
                ],
                backgroundColor: ['#FF5722', '#34C759', '#00BCD4'],
                borderWidth: 0,
                cutout: '80%'
            }]
        },
        options: {
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
        }
    });

    const cityCtx = document.getElementById('cityDensityChart').getContext('2d');
    new Chart(cityCtx, {
        type: 'bar',
        data: {
            labels: <%- JSON.stringify(cityStats.map(s => s.city)) %>,
            datasets: [{
                label: 'Density',
                data: <%- JSON.stringify(cityStats.map(s => s.count)) %>,
                backgroundColor: '#FF9F0A',
                borderRadius: 2
            }]
        },
        options: {
            indexAxis: 'y',
            maintainAspectRatio: false,
            scales: {
                x: { grid: { color: '#222' }, ticks: { color: '#FFF', font: { size: 10 } } },
                y: { grid: { display: false }, ticks: { color: '#FFF', font: { size: 10 } } }
            },
            plugins: { legend: { display: false } }
        }
    });

    fetch('/admin/reports/api/users')
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                document.getElementById('val-dau').innerText = res.data.dau;
                document.getElementById('val-fleet').innerText = res.data.active_fulfillers;
            }
        });
</script>
