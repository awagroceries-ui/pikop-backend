<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Marketplace Stores</h4>
    <p class="text-muted small mb-0">Manage Vendors and Storefronts across the platform.</p>
</div>

<div class="card-pikop">
    <% if (vendors.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No active vendors found. Marketplace expansion ready.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Business Entity</th>
                        <th class="text-center">CAC Status</th>
                        <th class="text-center">Account Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% vendors.forEach(v => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= v.business_name %></div>
                                <div class="smaller text-muted"><%= v.contact_email %></div>
                            </td>
                            <td class="text-center text-black small fw-bold">
                                <%= v.cac_number || 'NOT REGISTERED' %>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= v.status === 'active' ? 'bg-green' : 'bg-gold' %> text-white fw-bold px-3">
                                    <%= v.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn-pikop-outline py-1 px-3" style="font-size: 11px;">CATALOG</button>
                                    <button class="btn-pikop-primary py-1 px-3" style="font-size: 11px;">EDIT</button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
    .bg-gold { background-color: var(--gold) !important; color: var(--black) !important; }
</style>
