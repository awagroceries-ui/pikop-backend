<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Marketplace Stores</h4>
    <p class="text-muted small mb-0">Manage Vendors, Storefronts, Status, and Store Deletion.</p>
</div>

<div class="card-pikop">
    <% if (vendors.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No active vendors found. Marketplace expansion ready.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Business Entity</th>
                        <th class="text-center">Category</th>
                        <th class="text-center">Accepts COD</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% vendors.forEach(v => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= v.business_name %></div>
                                <div class="smaller text-muted">Owner: <%= v.contact_person %> (<%= v.contact_email %>)</div>
                                <div class="smaller text-muted">CAC: <%= v.cac_number || 'None' %></div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-black border"><%= v.category %></span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= v.accepts_cod ? 'bg-success' : 'bg-secondary' %> text-white">
                                    <%= v.accepts_cod ? 'YES' : 'NO' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= v.status === 'active' ? 'bg-green' : v.status === 'suspended' ? 'bg-warning text-dark' : 'bg-danger' %> text-white fw-bold px-3">
                                    <%= v.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <% if (v.status !== 'active') { %>
                                        <form action="/admin/merchants/vendor/<%= v.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="VERIFIED">
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 11px;">APPROVE</button>
                                        </form>
                                    <% } %>
                                    <% if (v.status !== 'suspended') { %>
                                        <form action="/admin/merchants/vendor/<%= v.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="suspended">
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size: 11px;">SUSPEND</button>
                                        </form>
                                    <% } %>
                                    <% if (v.status !== 'banned') { %>
                                        <form action="/admin/merchants/vendor/<%= v.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="banned">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">BAN</button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/merchants/vendor/<%= v.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete vendor store and all products?')">
                                        <button type="submit" class="btn btn-sm btn-danger py-0 px-2" style="font-size: 11px;">DELETE</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
</style>
