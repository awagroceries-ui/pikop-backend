<div class="mb-5">
    <h3 class="fw-extrabold mb-1 ls-1">Marketplace Partners</h3>
    <p class="text-muted small">Manage Vendors and Storefronts across the platform.</p>
</div>

<div class="row g-4">
    <% if (vendors.length === 0) { %>
        <div class="col-12">
            <div class="card bg-card border-0 p-5 text-center">
                <p class="text-muted mb-0">No active vendors found. Marketplace expansion ready.</p>
            </div>
        </div>
    <% } else { %>
        <% vendors.forEach(v => { %>
            <div class="col-md-12">
                <div class="card bg-card border-0 p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <h6 class="mb-1 text-white fw-bold"><%= v.business_name %></h6>
                            <span class="text-muted small">CAC: <%= v.cac_number || 'N/A' %></span>
                        </div>
                        <div class="col-md-3">
                            <span class="badge <%= v.status === 'active' ? 'bg-success' : 'bg-warning text-dark' %>">
                                <%= v.status.toUpperCase() %>
                            </span>
                        </div>
                        <div class="col-md-5 text-end">
                            <button class="btn btn-sm btn-outline-secondary px-3">Catalog</button>
                            <button class="btn btn-sm btn-outline-primary px-3 ms-2">Edit</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>
