<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold mb-1 text-black" style="letter-spacing: -0.5px;">Mission Board</h3>
        <p class="text-muted small">Real-time status of all pickup and delivery operations.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/orders" class="btn btn-sm <%= !filters.type ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
        <a href="/admin/orders?type=COD" class="btn btn-sm <%= filters.type === 'COD' ? 'btn-primary' : 'btn-outline-primary' %>">COD / Escrow</a>
    </div>
</div>

<div class="row g-4">
    <% if (orders.length === 0) { %>
        <div class="col-12">
            <div class="card-pikop p-5 text-center">
                <p class="text-muted mb-0">No missions found in the current cycle.</p>
            </div>
        </div>
    <% } else { %>
        <% orders.forEach(order => { %>
            <div class="col-md-12">
                <div class="card-pikop p-4 mb-3">
                    <div class="row align-items-center">
                        <div class="col-md-2">
                            <span class="text-muted smaller fw-bold uppercase mb-1 d-block" style="font-size: 10px; letter-spacing: 1px;">Mission ID</span>
                            <div class="text-black small mono fw-bold">#<%= order.id.toString().slice(-8).toUpperCase() %></div>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted smaller fw-bold uppercase mb-1 d-block" style="font-size: 10px; letter-spacing: 1px;">Customer</span>
                            <div class="text-black small fw-bold"><%= order.user_name %></div>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted smaller fw-bold uppercase mb-1 d-block" style="font-size: 10px; letter-spacing: 1px;">Agent</span>
                            <div class="text-black small fw-bold"><%= order.fulfiller_name || 'UNASSIGNED' %></div>
                            <% if (order.fulfiller_id) { %>
                                <div class="smaller text-muted" style="font-size: 9px;">ID: #<%= order.fulfiller_id %></div>
                            <% } %>
                        </div>
                        <div class="col-md-2 text-center">
                            <span class="text-muted smaller fw-bold uppercase mb-1 d-block" style="font-size: 10px; letter-spacing: 1px;">Status</span>
                            <span class="badge <%= order.status === 'DELIVERED' ? 'bg-green' : 'bg-gold' %> text-white fw-bold smaller" style="padding: 5px 10px;">
                                <%= order.status %>
                            </span>
                            <% if (order.item_price > 0) { %>
                                <div class="mt-1 smaller text-primary fw-bold" style="font-size: 9px;">COD/ESCROW</div>
                            <% } %>
                        </div>
                        <div class="col-md-2 text-center">
                            <span class="text-muted smaller fw-bold uppercase mb-1 d-block" style="font-size: 10px; letter-spacing: 1px;">Fare</span>
                            <div class="text-green fw-bold mono">₦<%= parseFloat(order.total_fare).toLocaleString() %></div>
                        </div>
                        <div class="col-md-4 text-end">
                            <a href="/admin/orders/<%= order.id %>/track" class="btn-pikop-outline py-1 px-3 me-1" style="font-size: 11px; text-decoration: none;">TRACK MISSION</a>
                            <button class="btn btn-xs btn-outline-success py-1 px-2 fw-bold" style="font-size: 10px;" onclick="openManualDispatch(<%= order.id %>)">MANUAL ASSIGN</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<div class="modal fade" id="manualDispatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Assign Mission <span id="mdOrderLabel"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="mdLoading" class="text-muted small">Loading online agents…</div>
                <div id="mdEmpty" class="text-muted small d-none">No agents are currently online and KYC-verified. Manual assignment needs at least one online agent.</div>
                <select id="mdAgentSelect" class="form-select d-none"></select>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="mdConfirmBtn" class="btn btn-sm btn-success d-none" onclick="confirmManualDispatch()">Assign</button>
            </div>
        </div>
    </div>
</div>

<script>
    let mdCurrentOrderId = null;
    let mdModalInstance = null;

    function openManualDispatch(orderId) {
        mdCurrentOrderId = orderId;
        document.getElementById('mdOrderLabel').textContent = '#' + orderId;
        document.getElementById('mdLoading').classList.remove('d-none');
        document.getElementById('mdEmpty').classList.add('d-none');
        const select = document.getElementById('mdAgentSelect');
        select.classList.add('d-none');
        select.innerHTML = '';
        document.getElementById('mdConfirmBtn').classList.add('d-none');

        mdModalInstance = mdModalInstance || new bootstrap.Modal(document.getElementById('manualDispatchModal'));
        mdModalInstance.show();

        fetch('/admin/agents/online.json')
            .then(res => res.json())
            .then(data => {
                document.getElementById('mdLoading').classList.add('d-none');
                const agents = data.agents || [];
                if (agents.length === 0) {
                    document.getElementById('mdEmpty').classList.remove('d-none');
                    return;
                }
                agents.forEach(a => {
                    const opt = document.createElement('option');
                    opt.value = a.id;
                    opt.textContent = `${a.full_name} — ${a.primary_class || a.mobility_type || 'Agent'} — #${a.id}`;
                    select.appendChild(opt);
                });
                select.classList.remove('d-none');
                document.getElementById('mdConfirmBtn').classList.remove('d-none');
            })
            .catch(e => {
                document.getElementById('mdLoading').textContent = 'Failed to load agents: ' + e.message;
            });
    }

    function confirmManualDispatch() {
        const select = document.getElementById('mdAgentSelect');
        const fulfillerId = parseInt(select.value);
        if (!fulfillerId) return;

        fetch(`/admin/orders/${mdCurrentOrderId}/assign`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fulfiller_id: fulfillerId })
        })
        .then(res => res.json())
        .then(data => {
            alert(data.message || 'Mission Assigned Successfully!');
            window.location.reload();
        })
        .catch(e => alert('Dispatch failed: ' + e.message));
    }
</script>

<style>
    .bg-green { background-color: var(--green) !important; }
    .bg-gold { background-color: var(--gold) !important; color: var(--black) !important; }
    .text-green { color: var(--green) !important; }
</style>
