<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Corporate Accounts Management</h2>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Company Name</th>
                        <th>Owner</th>
                        <th>CAC & Document</th>
                        <th>Staff Count</th>
                        <th>Billing Type</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (accounts.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No corporate accounts registered.</td>
                        </tr>
                    <% } else { %>
                        <% accounts.forEach(acc => { %>
                            <tr>
                                <td>
                                    <strong><%= acc.company_name %></strong>
                                    <div class="small text-muted"><%= acc.business_address || 'No address provided' %></div>
                                </td>
                                <td>
                                    <%= acc.owner_name %>
                                    <div class="small text-muted"><%= acc.owner_email %> | <%= acc.owner_phone %></div>
                                </td>
                                <td>
                                    <code>CAC: <%= acc.cac_number || 'N/A' %></code>
                                    <% if (acc.doc_url) { %>
                                        <div class="mt-1">
                                            <a href="<%= acc.doc_url %>" target="_blank" class="btn btn-sm btn-outline-success py-0 px-2">
                                                📄 View CAC Document
                                            </a>
                                        </div>
                                    <% } else { %>
                                        <div class="small text-muted mt-1">No Document Uploaded</div>
                                    <% } %>
                                </td>
                                <td><span class="badge bg-secondary"><%= acc.staff_count %> Staff</span></td>
                                <td><span class="badge bg-info text-dark"><%= (acc.billing_type || 'PREPAID_WALLET').toUpperCase() %></span></td>
                                <td>
                                    <% if (acc.status === 'ACTIVE') { %>
                                        <span class="badge bg-success">ACTIVE</span>
                                    <% } else if (acc.status === 'PENDING_VERIFICATION') { %>
                                        <span class="badge bg-warning text-dark">PENDING VERIFICATION</span>
                                    <% } else if (acc.status === 'REJECTED') { %>
                                        <span class="badge bg-danger">REJECTED</span>
                                    <% } else { %>
                                        <span class="badge bg-danger">SUSPENDED</span>
                                    <% } %>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editCorporateModal<%= acc.id %>">
                                        Manage Account
                                    </button>
                                </td>
                            </tr>

                            <!-- Modal: Edit Corporate -->
                            <div class="modal fade" id="editCorporateModal<%= acc.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/admin/corporate/<%= acc.id %>/status" method="POST">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Manage <%= acc.company_name %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Verification & Account Status</label>
                                                    <select name="status" class="form-select">
                                                        <option value="ACTIVE" <%= acc.status === 'ACTIVE' ? 'selected' : '' %>>Active / Approved</option>
                                                        <option value="PENDING_VERIFICATION" <%= acc.status === 'PENDING_VERIFICATION' ? 'selected' : '' %>>Pending Verification</option>
                                                        <option value="SUSPENDED" <%= acc.status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
                                                        <option value="REJECTED" <%= acc.status === 'REJECTED' ? 'selected' : '' %>>Rejected</option>
                                                    </select>
                                                </div>
                                                <% if (acc.doc_url) { %>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">Submitted Document</label>
                                                        <div>
                                                            <a href="<%= acc.doc_url %>" target="_blank" class="btn btn-outline-success btn-sm">
                                                                📄 Inspect Uploaded Document
                                                            </a>
                                                        </div>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Save Changes</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
