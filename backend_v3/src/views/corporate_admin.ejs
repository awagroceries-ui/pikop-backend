<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Corporate Accounts Management</h2>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Company Name</th>
                        <th>Owner</th>
                        <th>CAC Number</th>
                        <th>Staff Count</th>
                        <th>Credit Limit</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (accounts.length === 0) { %>
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No corporate accounts registered.</td>
                        </tr>
                    <% } else { %>
                        <% accounts.forEach(acc => { %>
                            <tr>
                                <td>
                                    <strong><%= acc.company_name %></strong>
                                    <div class="small text-muted"><%= acc.business_address || 'No address provided' %></div>
                                </td>
                                <td>
                                    <%= acc.owner_name %>
                                    <div class="small text-muted"><%= acc.owner_email %> | <%= acc.owner_phone %></div>
                                </td>
                                <td><code><%= acc.cac_number || 'N/A' %></code></td>
                                <td><span class="badge bg-secondary"><%= acc.staff_count %> Staff</span></td>
                                <td><strong>₦<%= (parseFloat(acc.monthly_credit_limit || 0)).toLocaleString() %></strong></td>
                                <td>
                                    <span class="badge bg-<%= acc.is_active ? 'success' : 'danger' %>">
                                        <%= acc.is_active ? 'ACTIVE' : 'SUSPENDED' %>
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editCorporateModal<%= acc.id %>">
                                        Edit Status/Limit
                                    </button>
                                </td>
                            </tr>

                            <!-- Modal: Edit Corporate -->
                            <div class="modal fade" id="editCorporateModal<%= acc.id %>" tabindex="-1">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <form action="/admin/corporate/<%= acc.id %>/status" method="POST">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Manage <%= acc.company_name %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Account Status</label>
                                                    <select name="is_active" class="form-select">
                                                        <option value="true" <%= acc.is_active ? 'selected' : '' %>>Active / Approved</option>
                                                        <option value="false" <%= !acc.is_active ? 'selected' : '' %>>Suspended</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label fw-bold">Monthly Credit Limit (₦)</label>
                                                    <input type="number" name="monthly_credit_limit" class="form-control" value="<%= acc.monthly_credit_limit %>">
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary">Update Account</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
