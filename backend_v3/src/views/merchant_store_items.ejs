<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <div class="smaller text-muted fw-bold uppercase mb-1" style="font-size: 11px;">
            <a href="/admin/merchants" class="text-decoration-none text-muted">Merchant Hub</a> &gt; Store Contents
        </div>
        <h4 class="fw-bold mb-1 text-black"><%= merchant.business_name %></h4>
        <p class="text-muted small mb-0">
            Owner: <strong><%= merchant.contact_person || 'N/A' %></strong> (<%= merchant.contact_email %>) &bull;
            Type: <span class="badge bg-light text-black border text-uppercase"><%= type %></span> &bull;
            Category: <span class="badge bg-light text-black border"><%= merchant.category || 'General' %></span>
        </p>
    </div>
    <div>
        <a href="/admin/merchants" class="btn btn-sm btn-outline-secondary px-3">Back to Merchants</a>
    </div>
</div>

<!-- Store Summary Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card-pikop p-3">
            <div class="text-muted smaller fw-bold uppercase mb-1" style="font-size: 10px;">TOTAL LISTED ITEMS</div>
            <div class="h4 fw-bold mb-0 text-black"><%= items.length %></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-pikop p-3">
            <div class="text-muted smaller fw-bold uppercase mb-1" style="font-size: 10px;">ACTIVE / AVAILABLE</div>
            <div class="h4 fw-bold mb-0 text-success">
                <%= items.filter(i => (type === 'vendor' ? i.active : i.available)).length %>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-pikop p-3">
            <div class="text-muted smaller fw-bold uppercase mb-1" style="font-size: 10px;">DISABLED / DELISTED</div>
            <div class="h4 fw-bold mb-0 text-danger">
                <%= items.filter(i => !(type === 'vendor' ? i.active : i.available)).length %>
            </div>
        </div>
    </div>
</div>

<!-- Items Table -->
<div class="card-pikop">
    <% if (items.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No items listed in this store yet.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop align-middle">
                <thead>
                    <tr>
                        <th style="width: 60px;">Photo</th>
                        <th>Item Details</th>
                        <th class="text-center">Category</th>
                        <th class="text-end">Price (₦)</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Regulation Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% items.forEach(item => { %>
                        <% const isLive = (type === 'vendor' ? item.active : item.available); %>
                        <tr>
                            <td>
                                <% if (item.photo_url) { %>
                                    <img src="<%= item.photo_url.startsWith('http') ? item.photo_url : 'https://api.pikop.com.ng' + item.photo_url %>"
                                         alt="<%= item.name %>"
                                         class="rounded border"
                                         style="width: 48px; height: 48px; object-fit: cover;">
                                <% } else { %>
                                    <div class="rounded border bg-light d-flex align-items-center justify-content-center text-muted smaller" style="width: 48px; height: 48px; font-size: 9px;">NO PIC</div>
                                <% } %>
                            </td>
                            <td>
                                <div class="fw-bold text-black"><%= item.name %></div>
                                <div class="smaller text-muted text-truncate" style="max-width: 280px;"><%= item.description || 'No description' %></div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-black border small"><%= item.category || 'General' %></span>
                            </td>
                            <td class="text-end fw-bold text-black">
                                ₦<%= Number(item.price).toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= isLive ? 'bg-green' : 'bg-secondary' %> text-white fw-bold px-3">
                                    <%= isLive ? 'ACTIVE' : 'DISABLED' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <!-- Toggle Status Form -->
                                    <form action="/admin/merchants/<%= type %>/<%= merchant.id %>/items/<%= item.id %>/toggle" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm <%= isLive ? 'btn-outline-warning' : 'btn-outline-success' %> py-1 px-2" style="font-size: 11px;">
                                            <%= isLive ? 'DISABLE' : 'ENABLE' %>
                                        </button>
                                    </form>

                                    <!-- Edit Button (Triggers Modal) -->
                                    <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 11px;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal<%= item.id %>">
                                        EDIT
                                    </button>

                                    <!-- Delete Form -->
                                    <form action="/admin/merchants/<%= type %>/<%= merchant.id %>/items/<%= item.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete this item permanently?')">
                                        <button type="submit" class="btn btn-sm btn-danger py-1 px-2" style="font-size: 11px;">DELETE</button>
                                    </form>
                                </div>

                                <!-- Edit Modal -->
                                <div class="modal fade text-start" id="editModal<%= item.id %>" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content card-pikop p-3">
                                            <div class="modal-header border-0">
                                                <h5 class="modal-title fw-bold text-black">Edit Item: <%= item.name %></h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <form action="/admin/merchants/<%= type %>/<%= merchant.id %>/items/<%= item.id %>/edit" method="POST">
                                                <div class="modal-body py-2">
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Item Name</label>
                                                        <input type="text" name="name" class="form-control form-control-sm" value="<%= item.name %>" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Price (₦)</label>
                                                        <input type="number" step="0.01" name="price" class="form-control form-control-sm" value="<%= item.price %>" required>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Category</label>
                                                        <input type="text" name="category" class="form-control form-control-sm" value="<%= item.category || '' %>">
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-bold text-muted">Description</label>
                                                        <textarea name="description" class="form-control form-control-sm" rows="3"><%= item.description || '' %></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0">
                                                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-pikop-primary">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
</style>
