<div class="mb-5">
    <h3 class="fw-bold mb-1 text-black"><%= title.toUpperCase() %></h3>
    <p class="text-muted small">Platform Compliance & Protocol Documentation.</p>
</div>

<div class="row g-4">
    <div class="col-md-9">
        <div class="card card-pikop p-5" style="line-height: 1.8;">
            <div class="legal-content text-black">
                <%- content %>
            </div>

            <div class="mt-5 pt-5 border-top text-center">
                <p class="small text-muted fw-bold">LAST UPDATED: AUGUST 18, 2026</p>
            </div>
        </div>
    </div>
</div>

<style>
    .legal-content h4 { margin-top: 2rem; letter-spacing: 0.5px; font-weight: 700; color: var(--green); }
    .legal-content p { font-size: 1rem; margin-bottom: 1.5rem; }
    .legal-content strong { color: var(--black); font-weight: 700; }
</style>
