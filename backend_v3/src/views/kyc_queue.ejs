<div class="mb-5">
    <h4 class="fw-bold mb-1 text-white">Fleet Authentication</h4>
    <p class="text-white opacity-50 small mb-0">Management of fulfiller identity and operational credentials.</p>
</div>

<div class="card-pikop">
    <% if (fulfillers.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-white opacity-50 mb-0">No pending fleet authentications.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Fulfiller</th>
                        <th>Class</th>
                        <th class="text-center">Identity (Didit)</th>
                        <th class="text-center">KYC Progress</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% fulfillers.forEach(f => { %>
                        <tr class="align-middle">
                            <td><span class="fw-bold text-white"><%= f.full_name %></span></td>
                            <td><span class="badge bg-white text-black fw-bold uppercase" style="font-size: 10px;"><%= f.primary_class %></span></td>
                            <td class="text-center">
                                <span class="badge <%= f.didit_verification_status === 'approved' ? 'bg-green' : 'bg-gold' %> text-black fw-bold" style="font-size: 10px;">
                                    <%= f.didit_verification_status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-center text-white opacity-75 small fw-bold"><%= f.kyc_status %></td>
                            <td class="text-end">
                                <button class="btn-pikop-primary py-1 px-3" style="font-size: 11px;">REVIEW</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
    .bg-gold { background-color: var(--gold) !important; }
</style>
