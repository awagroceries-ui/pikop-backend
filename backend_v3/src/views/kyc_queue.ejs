<div class="mb-5">
    <h3 class="fw-black mb-1 ls-1 text-white">FLEET AUTHENTICATION QUEUE</h3>
    <p class="text-white opacity-75 small fw-bold">Sequential review of fulfiller identity and operational credentials.</p>
</div>

<div class="row g-4">
    <% if (fulfillers.length === 0) { %>
        <div class="col-12">
            <div class="card p-5 text-center" style="background: #000; border: 3px solid #FFF;">
                <p class="text-white fw-black mb-0">NO PENDING FLEET AUTHENTICATIONS.</p>
            </div>
        </div>
    <% } else { %>
        <% fulfillers.forEach(f => { %>
            <div class="col-md-12">
                <div class="card p-4" style="background: #0A0A0A; border: 2px solid #FFF;">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <h5 class="mb-1 text-white fw-black"><%= f.full_name.toUpperCase() %></h5>
                            <span class="badge bg-primary text-black fw-black"><%= f.primary_class.toUpperCase() %></span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-white opacity-75 smaller ls-1 uppercase fw-black">IDENTITY (DIDIT)</span>
                            <div class="mt-2">
                                <span class="badge <%= f.didit_verification_status === 'approved' ? 'bg-success' : 'bg-warning text-black' %> fw-black px-3">
                                    <%= f.didit_verification_status.toUpperCase() %>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <span class="text-white opacity-75 smaller ls-1 uppercase fw-black">KYC PROGRESS</span>
                            <div class="mt-2">
                                <span class="text-white fw-black"><%= f.kyc_status %></span>
                            </div>
                        </div>
                        <div class="col-md-3 text-end">
                            <button class="btn btn-primary px-4 fw-black ls-1">REVIEW DOCUMENTS</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>
