<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h4 class="fw-bold mb-1 text-white">Administrative Access</h4>
        <p class="text-white opacity-50 small mb-0">System administrators and operational roles.</p>
    </div>
    <button class="btn-pikop-primary px-4">NEW ADMINISTRATOR</button>
</div>

<div class="card-pikop">
    <div class="table-responsive">
        <table class="table-pikop">
            <thead>
                <tr>
                    <th>Security Identity</th>
                    <th>Clearance Role</th>
                    <th class="text-center">Member Since</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr class="align-middle">
                        <td><span class="fw-bold text-white"><%= user.username %></span></td>
                        <td><span class="badge bg-gold text-black fw-bold px-3" style="font-size: 10px;"><%= user.role.toUpperCase() %></span></td>
                        <td class="text-center text-white opacity-50 small"><%= new Date(user.created_at).toLocaleDateString() %></td>
                        <td class="text-end">
                            <button class="btn-pikop-outline py-1 px-3" style="font-size: 11px;">SETTINGS</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<style>
    .bg-gold { background-color: var(--gold) !important; }
</style>
