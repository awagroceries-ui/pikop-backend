<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="row g-0 h-100" style="margin: -3rem;">
    <!-- Sidebar Details -->
    <div class="col-md-3 bg-white border-end p-4 shadow-sm" style="z-index: 1000; height: calc(100vh - 70px); overflow-y: auto;">
        <a href="/admin/orders" class="btn btn-sm btn-outline-secondary mb-4">← Back to Board</a>

        <h4 class="fw-bold mb-1">Mission #<%= order.id.toString().slice(-8).toUpperCase() %></h4>
        <div class="d-flex align-items-center gap-2 mb-4">
            <span class="badge bg-success text-uppercase"><%= order.status.replace(/_/g, ' ') %></span>
            <% if (order.agent_name) { %>
                <span class="smaller text-muted fw-bold">| AGENT ASSIGNED</span>
            <% } %>
        </div>

        <div class="mb-4">
            <label class="text-muted smaller fw-bold uppercase d-block mb-1">Customer (Payer)</label>
            <div class="fw-bold text-black"><%= order.customer_name %></div>
            <div class="small text-muted"><%= order.customer_phone %></div>
        </div>

        <div class="mb-4 border-top pt-3">
            <label class="text-muted smaller fw-bold uppercase d-block mb-1">Active Agent</label>
            <% if (order.agent_name) { %>
                <div class="fw-bold text-primary">
                    Agent: <%= order.agent_name %>
                    <span class="text-muted small">(#F<%= order.agent_db_id %>)</span>
                </div>
                <div class="smaller text-muted text-uppercase mb-2">
                    <%= order.primary_class %> &bull; <%= order.tier %> Agent
                </div>
                <div class="small text-muted"><%= order.agent_phone %></div>
                <div class="mt-2">
                    <a href="/admin/fulfillers/<%= order.agent_db_id %>" class="btn btn-xs btn-outline-primary py-0 px-2" style="font-size: 10px;">MANAGE AGENT</a>
                </div>
                <div id="eta-box" class="mt-3 small fw-bold text-success">Tracking live agent...</div>
            <% } else { %>
                <div class="text-warning small italic">Waiting for agent acceptance...</div>
            <% } %>
        </div>

        <div class="mb-4 border-top pt-3">
            <label class="text-muted smaller fw-bold uppercase d-block mb-1">Items</label>
            <div class="small"><%= order.item_description %></div>
            <div class="smaller text-muted mt-1">Tier: <%= order.size_tier %></div>
        </div>

        <div class="border-top pt-3">
            <label class="text-muted smaller fw-bold uppercase d-block mb-1">Route</label>
            <div class="small mb-2"><strong>Pick:</strong> <%= order.pickup_address %></div>
            <div class="small"><strong>Drop:</strong> <%= order.delivery_address %></div>
        </div>

        <div class="mb-4 border-top pt-3">
            <label class="text-muted smaller fw-bold uppercase d-block mb-1">Financial Audit</label>
            <div class="small">
                <div class="d-flex justify-content-between"><span>Item Price:</span> <span class="fw-bold">₦<%= parseFloat(order.item_price || 0).toLocaleString() %></span></div>
                <div class="d-flex justify-content-between"><span>Delivery:</span> <span class="fw-bold">₦<%= parseFloat(order.delivery_fee || 0).toLocaleString() %></span></div>
                <div class="d-flex justify-content-between"><span>Platform Fee:</span> <span class="fw-bold">₦<%= parseFloat(order.platform_fee_amount || 0).toLocaleString() %></span></div>
                <div class="d-flex justify-content-between border-top mt-1 pt-1"><span class="fw-bold">Total:</span> <span class="fw-bold text-success">₦<%= parseFloat(order.total_fare).toLocaleString() %></span></div>
            </div>
            <% if (order.item_price > 0) { %>
                <div class="mt-2 p-2 bg-light rounded smaller border">
                    <strong>Escrow Status:</strong> <span class="text-uppercase text-primary"><%= order.escrow_status %></span><br>
                    <strong>Payer:</strong> <%= order.fee_payer %>
                </div>
            <% } %>
        </div>

        <div class="mb-4 border-top pt-3">
            <label class="text-muted smaller fw-bold uppercase d-block mb-2">Order Ledger</label>
            <div style="max-height: 150px; overflow-y: auto;">
                <% if (ledger.length === 0) { %>
                    <div class="smaller text-muted italic">No ledger entries yet.</div>
                <% } else { %>
                    <% ledger.forEach(entry => { %>
                        <div class="mb-2 pb-1 border-bottom smaller">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold text-<%= entry.entry_type === 'CREDIT' ? 'success' : 'danger' %>"><%= entry.entry_type %></span>
                                <span>₦<%= parseFloat(entry.amount).toLocaleString() %></span>
                            </div>
                            <div class="text-muted" style="font-size: 9px;"><%= entry.purpose %> - <%= new Date(entry.created_at).toLocaleTimeString() %></div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </div>

        <div class="border-top pt-3 mt-4">
            <label class="text-muted smaller fw-bold uppercase d-block mb-2">Manual Order Override</label>
            <div class="d-grid gap-2">
                <% if (order.status !== 'DELIVERED') { %>
                    <form action="/admin/orders/<%= order.id %>/update" method="POST">
                        <input type="hidden" name="status" value="DELIVERED">
                        <button type="submit" class="btn btn-sm btn-success fw-bold w-100">Force Mark as Delivered</button>
                    </form>
                <% } %>
                <% if (order.status !== 'CANCELLED') { %>
                    <form action="/admin/orders/<%= order.id %>/update" method="POST">
                        <input type="hidden" name="status" value="CANCELLED">
                        <button type="submit" class="btn btn-sm btn-outline-danger fw-bold w-100">Cancel Mission</button>
                    </form>
                <% } %>
            </div>
        </div>
    </div>

    <!-- Map View -->
    <div class="col-md-9 h-100">
        <div id="map" style="height: calc(100vh - 70px); width: 100%;"></div>
    </div>
</div>

<script>
    const pickup = [<%= order.pickup_lat || 0 %>, <%= order.pickup_lng || 0 %>];
    const delivery = [<%= order.delivery_lat || 0 %>, <%= order.delivery_lng || 0 %>];
    const initialAgent = <%= (order.agent_lat && order.agent_lng) ? `[${order.agent_lat}, ${order.agent_lng}]` : 'null' %>;

    // Initialize Map
    const map = L.map('map').setView(pickup, 13);

    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', {
        attribution: 'Tiles &copy; Esri &mdash; Source: Esri, DeLorme, NAVTEQ, USGS, Intermap, iPC, NRCAN, Esri Japan, METI, Esri China (Hong Kong), Esri (Thailand), TomTom, 2012',
        maxZoom: 19
    }).addTo(map);

    // Custom Icons
    const pickIcon = L.icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-green.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41] });
    const dropIcon = L.icon({ iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png', shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png', iconSize: [25, 41], iconAnchor: [12, 41] });

    // Map mobility type to specific marker asset
    const mobility = "<%= order.mobility_type || 'bike' %>";
    const markerMap = {
        'agent': 'marker_agent.png',
        'walking': 'marker_agent.png',
        'bicycle': 'marker_rider.png',
        'bike': 'marker_bike.png',
        'motorcycle': 'marker_bike.png',
        'driver': 'marker_driver.png',
        'car': 'marker_driver.png'
    };
    const iconFile = markerMap[mobility.toLowerCase()] || 'marker_bike.png';
    const agentIcon = L.icon({ iconUrl: `/public/assets/${iconFile}`, iconSize: [36, 36], iconAnchor: [18, 18] });

    // Add Static Markers
    L.marker(pickup, { icon: pickIcon }).addTo(map).bindPopup("<b>Pickup Point</b>");
    L.marker(delivery, { icon: dropIcon }).addTo(map).bindPopup("<b>Delivery Destination</b>");

    // Live Agent Marker
    let agentMarker = null;
    if (initialAgent) {
        agentMarker = L.marker(initialAgent, { icon: agentIcon }).addTo(map).bindPopup("<b>Active Agent</b>");
    }

    // Fitting map bounds
    const group = new L.featureGroup([
        L.marker(pickup),
        L.marker(delivery)
    ]);
    map.fitBounds(group.getBounds().pad(0.2));

    // Live Socket Updates
    socket.emit('join_order', { orderId: "<%= order.id %>" });

    socket.on('location_updated', (data) => {
        console.log('[Live] Agent location update:', data);
        const newPos = [data.lat, data.lng];

        if (!agentMarker) {
            agentMarker = L.marker(newPos, { icon: agentIcon }).addTo(map).bindPopup("<b>Active Agent</b>");
        } else {
            agentMarker.setLatLng(newPos);
        }

        document.getElementById('eta-box').innerText = "Signal Strong - Moving Live";
    });

    socket.on('status_updated', (data) => {
        console.log('[Live] Status change detected:', data.status);
        // Reload for ANY status update to refresh agent info and sidebar data
        window.location.reload();
    });
</script>

<style>
    .smaller { font-size: 11px; }
    .mono { font-family: 'JetBrains Mono', monospace; }
</style>
