<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Command V3 | Mission Control</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Initialize Socket globally for V3
        const socket = io({ transports: ['websocket'] });
    </script>

    <style>
        :root {
            --brand-black: #000000;
            --brand-gold: #FF9F0A;
            --brand-orange: #FF5722;
            --brand-green: #8BC34A;
            --brand-teal: #00BCD4;
            --brand-white: #FFFFFF;
            --bg-chrome: #000000;
            --bg-main: #000000;
            --bg-card: #0A0A0A;
            --text-main: #FFFFFF;
            --text-muted: #F8FAFC; /* High contrast off-white */
            --border: rgba(255,255,255,0.15);
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        .sidebar {
            min-height: 100vh;
            background: var(--bg-chrome);
            width: 260px;
            position: fixed;
            z-index: 1000;
            display: flex;
            flex-direction: column;
            border-right: 2px solid var(--border);
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 2.5rem 1.5rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

        .sidebar-group-label {
            padding: 1.5rem 1.5rem 0.5rem;
            font-size: 0.75rem;
            font-weight: 900;
            color: var(--brand-gold);
            text-transform: uppercase;
            letter-spacing: 0.15em;
        }

        .sidebar a {
            color: #FFFFFF;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 0.85rem 1.5rem;
            font-size: 0.95rem;
            font-weight: 700;
            transition: 0.2s all ease;
            gap: 14px;
        }

        .sidebar a:hover {
            color: var(--brand-gold);
            background: rgba(255, 159, 10, 0.1);
        }

        .active-link {
            color: var(--brand-gold) !important;
            background: rgba(255, 159, 10, 0.2) !important;
            border-right: 6px solid var(--brand-gold) !important;
        }

        .main-container {
            margin-left: 260px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-bar {
            background: var(--bg-chrome);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 999;
            border-bottom: 2px solid var(--border);
        }

        .notification-bell {
            position: relative;
            cursor: pointer;
            color: var(--brand-white);
            display: flex;
            align-items: center;
            padding: 8px;
            border-radius: 8px;
            transition: 0.2s all;
        }

        .notification-bell:hover {
            background: rgba(255,255,255,0.1);
        }

        .bell-dot {
            position: absolute;
            top: 6px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: var(--brand-orange);
            border-radius: 50%;
            border: 2px solid var(--brand-black);
            display: none;
        }

        .content-body { padding: 2.5rem; }

        .kpi-card {
            background: var(--bg-card);
            border: 2px solid var(--border);
            border-radius: 16px;
            padding: 1.5rem;
        }

        .badge-count {
            background: var(--brand-orange);
            color: white;
            font-size: 0.75rem;
            padding: 2px 8px;
            border-radius: 12px;
            margin-left: auto;
            font-weight: 900;
        }

        .btn-outline-light {
            border-color: #FFFFFF;
            color: #FFFFFF;
            font-weight: 800;
        }

        .text-muted { color: var(--text-muted) !important; font-weight: 500; }

        /* Utility for high contrast */
        .fw-black { font-weight: 900; }
        .ls-1 { letter-spacing: 1px; }
        .bg-card { background-color: #0A0A0A !important; }

    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <span class="fw-black text-white ls-1" style="font-size: 1.4rem;">PIKOP <span class="text-primary">V3</span></span>
            <div class="badge bg-danger ms-2" style="font-size: 0.6rem; font-weight: 900;">CORE</div>
        </div>

        <nav class="flex-grow-1">
            <div class="sidebar-group-label">Intelligence</div>
            <a href="/admin/dashboard" id="nav-dashboard">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                <span>Mission Control</span>
            </a>
            <a href="/admin/reports" id="nav-reports">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path></svg>
                <span>Analytics Hub</span>
            </a>

            <div class="sidebar-group-label">Core Delivery</div>
            <a href="/admin/orders" id="nav-orders">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                <span>Missions</span>
            </a>
            <a href="/admin/kyc" id="nav-kyc">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                <span>Fleet Auth</span>
                <span class="badge-count" id="kyc-badge" style="display:none">0</span>
            </a>

            <div class="sidebar-group-label">Partners</div>
            <a href="/admin/vendors" id="nav-vendors">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M16 11V7a4 4 0 00-8 0v4M5 9h12l1 12H4L5 9z"></path></svg>
                <span>Vendors</span>
            </a>
            <a href="/admin/kitchens" id="nav-kitchens">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.168.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                <span>Kitchens</span>
            </a>

            <div class="sidebar-group-label">Help Desk</div>
            <a href="/admin/support" id="nav-support">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
                <span>Support Inbox</span>
                <span class="badge-count" id="support-badge" style="display:none">0</span>
            </a>

            <div class="sidebar-group-label">System</div>
            <a href="/admin/settings" id="nav-settings">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                <span>Settings</span>
            </a>
            <a href="/admin/users" id="nav-users">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                <span>Admin Users</span>
            </a>
            <a href="/admin/profile" id="nav-profile">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                <span>My Profile</span>
            </a>

            <div class="sidebar-group-label" style="margin-top: 2rem;">Exit</div>
            <a href="/admin/logout" style="color: #FF5722 !important;">
                <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
                <span class="fw-black">SIGN OUT SYSTEM</span>
            </a>
        </nav>
    </aside>

    <div class="main-container">
        <header class="top-bar">
            <div class="d-flex align-items-center gap-4">
                <div class="d-flex align-items-center gap-3">
                    <span class="text-white smaller ls-1 fw-black uppercase">STATUS:</span>
                    <span class="badge bg-success text-black fw-black mono" style="font-size: 0.7rem;">OPERATIONAL</span>
                </div>
            </div>

            <div class="d-flex align-items-center gap-4">
                <!-- Notifications Icon -->
                <div class="notification-bell" onclick="window.location.href='/admin/support'">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                    </svg>
                    <div class="bell-dot" id="bell-dot"></div>
                </div>

                <div class="admin-profile d-flex align-items-center gap-3 border-start border-white border-opacity-10 ps-4">
                    <div class="text-end">
                        <div class="small fw-black text-white"><%= adminUsername %></div>
                        <div class="text-primary fw-black ls-1" style="font-size: 0.65rem;"><%= role ? role.toUpperCase() : 'STAFF' %></div>
                    </div>
                    <div class="rounded-circle bg-primary text-black fw-black d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border: 2px solid white;">OP</div>
                </div>
            </div>
        </header>

        <main class="content-body">
            <%- body %>
        </main>
    </div>

    <script>
        socket.on('new_support_alert', (data) => {
            showToast('New Message', data.body);
            updateBadge('support-badge');
            document.getElementById('bell-dot').style.display = 'block';
        });

        socket.on('new_kyc_alert', (data) => {
            showToast('KYC Upload', `New ${data.type} document submitted.`);
            updateBadge('kyc-badge');
            document.getElementById('bell-dot').style.display = 'block';
        });

        function updateBadge(id) {
            const badge = document.getElementById(id);
            if (badge) {
                badge.innerText = parseInt(badge.innerText || '0') + 1;
                badge.style.display = 'block';
            }
        }

        function showToast(title, body) {
            const notification = document.createElement('div');
            notification.className = 'position-fixed bottom-0 end-0 p-3';
            notification.style.zIndex = '9999';
            notification.innerHTML = `
                <div class="card bg-dark text-white border-primary shadow-lg" style="min-width: 250px; border-width: 2px;">
                    <div class="card-body">
                        <h6 class="fw-black text-primary mb-1">${title}</h6>
                        <p class="small mb-0 fw-bold">${body}</p>
                    </div>
                </div>
            `;
            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 5000);
        }

        const path = window.location.pathname;
        const navMap = {
            'dashboard': 'nav-dashboard',
            'reports': 'nav-reports',
            'orders': 'nav-orders',
            'kyc': 'nav-kyc',
            'vendors': 'nav-vendors',
            'kitchens': 'nav-kitchens',
            'support': 'nav-support',
            'settings': 'nav-settings',
            'users': 'nav-users',
            'profile': 'nav-profile'
        };
        Object.entries(navMap).forEach(([segment, id]) => {
            if (path.includes(segment)) {
                const el = document.getElementById(id);
                if (el) el.classList.add('active-link');
            }
        });
    </script>
</body>
</html>
