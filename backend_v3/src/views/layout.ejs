<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Command V3 | Mission Control</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io({ transports: ['websocket'] });
    </script>

    <style>
        :root {
            --gold: #FF9F0A;
            --white: #FFFFFF;
            --black: #000000;
            --red: #FF0000;
            --green: #00FF00;
        }

        body {
            background-color: #000000 !important;
            color: #FFFFFF !important;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Sidebar - Mandatory Visibility Fix */
        .sidebar {
            width: 280px;
            height: 100vh;
            background-color: #000000 !important;
            position: fixed;
            left: 0;
            top: 0;
            border-right: 3px solid #FFFFFF !important;
            z-index: 2000;
            display: flex;
            flex-direction: column;
        }

        .sidebar-header {
            padding: 2.5rem 1.5rem;
            border-bottom: 2px solid #FFFFFF;
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
            background: #000;
        }

        .sidebar-nav-container {
            flex-grow: 1;
            overflow-y: auto;
            padding-bottom: 40px;
        }

        .sidebar-nav-container::-webkit-scrollbar { width: 4px; }
        .sidebar-nav-container::-webkit-scrollbar-thumb { background: var(--gold); }

        .nav-group { margin-bottom: 2rem; }

        .nav-label {
            padding: 0 1.5rem 0.5rem;
            color: var(--gold) !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 2px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 0.9rem 1.5rem;
            color: #FFFFFF !important;
            text-decoration: none;
            font-weight: 800;
            font-size: 0.9rem;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            transition: all 0.2s;
        }

        .sidebar a:hover {
            background-color: rgba(255, 159, 10, 0.1);
            color: var(--gold) !important;
        }

        .active-link {
            background-color: var(--gold) !important;
            color: #000000 !important;
            border-right: 10px solid #FFFFFF !important;
        }

        .main-content {
            margin-left: 280px;
            min-height: 100vh;
            background-color: #000000 !important;
        }

        /* Top Bar - High Contrast */
        .top-bar {
            height: 80px;
            background-color: #000000 !important;
            border-bottom: 3px solid #FFFFFF !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 1001;
        }

        .notification-btn {
            background: none;
            border: 2px solid #FFFFFF;
            color: #FFFFFF;
            padding: 8px 12px;
            cursor: pointer;
            position: relative;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
            text-transform: uppercase;
            font-size: 0.75rem;
        }

        .notification-btn:hover { background: #FFFFFF; color: #000; }

        .red-dot {
            width: 10px;
            height: 10px;
            background-color: var(--red);
            border-radius: 50%;
            display: none;
            border: 2px solid #FFF;
        }

        .profile-box {
            display: flex;
            align-items: center;
            gap: 15px;
            border-left: 2px solid #FFFFFF;
            padding-left: 20px;
        }

        .content-inner { padding: 3rem; }

        .badge-v3 {
            padding: 5px 10px;
            background-color: var(--gold);
            color: #000;
            font-weight: 900;
            font-size: 0.7rem;
        }

        /* REMOVE ALL GREY/BLUE INSTANCES */
        .text-muted { color: #FFFFFF !important; opacity: 0.8; }
        .bg-card { background-color: #050505 !important; border: 1px solid #FFFFFF !important; }
        .small, .smaller { color: #FFFFFF !important; font-weight: 600; }

    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header">
            <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 60px; width: auto;">
            <div class="badge-v3">V3 OPERATIONAL HUB</div>
        </div>

        <div class="sidebar-nav-container">
            <div class="nav-group">
                <div class="nav-label">Intelligence</div>
                <a href="/admin/dashboard" id="nav-dashboard">📊 Mission Control</a>
                <a href="/admin/reports" id="nav-reports">📈 Analytics Hub</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">Operations</div>
                <a href="/admin/orders" id="nav-orders">LIVE MISSIONS</a>
                <a href="/admin/kyc" id="nav-kyc">FLEET AUTHENTICATION</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">Partners</div>
                <a href="/admin/vendors" id="nav-vendors">VENDORS</a>
                <a href="/admin/kitchens" id="nav-kitchens">KITCHENS</a>
                <a href="/admin/merchants" id="nav-merchants">MERCHANT HUB</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">System Admin</div>
                <a href="/admin/support" id="nav-support">SUPPORT INBOX</a>
                <a href="/admin/coupons" id="nav-coupons">COUPON ENGINE</a>
                <a href="/admin/settings" id="nav-settings">GLOBAL SETTINGS</a>
                <a href="/admin/users" id="nav-users">ADMIN USERS</a>
                <a href="/admin/profile" id="nav-profile">MY PROFILE</a>
            </div>

            <div class="nav-group" style="padding: 0 1.5rem;">
                <a href="/admin/logout" style="color: var(--red) !important; border: 2px solid var(--red); justify-content: center; background: rgba(255,0,0,0.1);">
                    SIGN OUT SYSTEM
                </a>
            </div>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-bar">
            <div class="fw-black text-white" style="letter-spacing: 1px;">
                STATUS: <span style="color: var(--green);">OPERATIONAL</span>
            </div>

            <div class="d-flex align-items-center gap-4">
                <button class="notification-btn" onclick="window.location.href='/admin/support'">
                    ALERTS <div class="red-dot" id="global-dot"></div>
                </button>

                <div class="profile-box">
                    <div class="text-end">
                        <div class="fw-bold text-white small"><%= adminUsername %></div>
                        <div class="smaller fw-black" style="color: var(--gold);"><%= role ? role.toUpperCase() : 'STAFF' %></div>
                    </div>
                    <div class="rounded-circle bg-primary text-black fw-black d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; border: 2px solid white;">OP</div>
                </div>
            </div>
        </header>

        <main class="content-inner">
            <%- body %>
        </main>
    </div>

    <script>
        function showFlash(title, msg) {
            const el = document.createElement('div');
            el.style.cssText = 'position:fixed; bottom:20px; right:20px; background:#FF9F0A; color:#000; padding:20px; font-weight:900; border:4px solid #FFF; z-index:9999;';
            el.innerHTML = `<div>${title.toUpperCase()}</div><div style="font-size: 0.75rem;">${msg}</div>`;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 6000);
        }

        socket.on('new_support_alert', (data) => {
            showFlash('New Message', data.body);
            document.getElementById('global-dot').style.display = 'block';
        });

        socket.on('new_kyc_alert', (data) => {
            showFlash('KYC Upload', 'A new document requires authentication.');
            document.getElementById('global-dot').style.display = 'block';
        });

        // Active Tab Highlighting
        const path = window.location.pathname;
        document.querySelectorAll('.sidebar a').forEach(l => {
            if (path === l.getAttribute('href')) {
                l.classList.add('active-link');
            }
        });
    </script>
</body>
</html>
