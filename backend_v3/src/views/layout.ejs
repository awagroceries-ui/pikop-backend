<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Command V3 | Mission Control</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        const socket = io({ transports: ['websocket'] });
    </script>

    <style>
        :root {
            --brand-gold: #FF9F0A;
            --brand-white: #FFFFFF;
            --brand-black: #000000;
            --brand-red: #FF0000;
            --brand-green: #00FF00;
        }

        body {
            background-color: #000000 !important;
            color: #FFFFFF !important;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Sidebar Hardening */
        .sidebar {
            width: 280px;
            height: 100vh;
            background-color: #000000 !important;
            position: fixed;
            left: 0;
            top: 0;
            border-right: 3px solid #FFFFFF !important;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .sidebar-header {
            padding: 2.5rem 1.5rem;
            border-bottom: 1px solid #FFFFFF;
            margin-bottom: 1rem;
        }

        .nav-group {
            margin-bottom: 2.5rem;
        }

        .nav-label {
            padding: 0 1.5rem 0.5rem;
            color: var(--brand-gold) !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 2px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 1rem 1.5rem;
            color: #FFFFFF !important;
            text-decoration: none;
            font-weight: 800;
            font-size: 0.95rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            transition: all 0.2s;
        }

        .sidebar a:hover {
            background-color: rgba(255, 159, 10, 0.1);
            color: var(--brand-gold) !important;
        }

        .active-link {
            background-color: var(--brand-gold) !important;
            color: #000000 !important;
            border-right: 10px solid #FFFFFF !important;
        }

        .main-content {
            margin-left: 280px;
            min-height: 100vh;
            background-color: #000000 !important;
            padding-bottom: 100px;
        }

        /* Top Bar Hardening */
        .top-bar {
            height: 80px;
            background-color: #000000 !important;
            border-bottom: 3px solid #FFFFFF !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 2rem;
            position: sticky;
            top: 0;
            z-index: 1001;
        }

        .notification-btn {
            background: none;
            border: 2px solid #FFFFFF;
            color: #FFFFFF;
            padding: 8px 12px;
            cursor: pointer;
            position: relative;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .notification-btn:hover { background: #FFFFFF; color: #000; }

        .red-dot {
            width: 12px;
            height: 12px;
            background-color: var(--brand-red);
            border-radius: 50%;
            display: none;
            border: 2px solid #000;
        }

        .profile-box {
            display: flex;
            align-items: center;
            gap: 15px;
            border-left: 1px solid #FFFFFF;
            padding-left: 20px;
        }

        .content-inner {
            padding: 3rem;
        }

        .badge-v3 {
            padding: 5px 12px;
            background-color: var(--brand-gold);
            color: #000;
            font-weight: 900;
            border-radius: 4px;
            font-size: 0.75rem;
        }

        /* High Contrast Tables */
        .table-pikop {
            width: 100%;
            background: #000;
            border: 1px solid #FFF;
        }
        .table-pikop th { color: var(--brand-gold); text-transform: uppercase; font-weight: 900; border-bottom: 2px solid #FFF; }
        .table-pikop td { color: #FFF; border-bottom: 1px solid rgba(255,255,255,0.2); }

    </style>
</head>
<body>
    <aside class="sidebar">
        <div class="sidebar-header d-flex flex-column align-items-center gap-2">
            <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 60px; width: auto;">
            <div class="badge-v3">V3 OPERATIONAL HUB</div>
        </div>

        <nav>
            <div class="nav-group">
                <div class="nav-label">Intelligence</div>
                <a href="/admin/dashboard" id="nav-dashboard">📊 Mission Control</a>
                <a href="/admin/reports" id="nav-reports">📈 Analytics Hub</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">Operations</div>
                <a href="/admin/orders" id="nav-orders">📦 Live Missions</a>
                <a href="/admin/kyc" id="nav-kyc">🪪 Fleet Authentication</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">Partners</div>
                <a href="/admin/vendors" id="nav-vendors">🏪 Marketplace Stores</a>
                <a href="/admin/kitchens" id="nav-kitchens">🍳 Kitchen Partners</a>
                <a href="/admin/merchants" id="nav-merchants">💼 Merchant Hub</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">System Admin</div>
                <a href="/admin/support" id="nav-support">💬 Support Inbox</a>
                <a href="/admin/settings" id="nav-settings">⚙️ Global Settings</a>
                <a href="/admin/users" id="nav-users">👥 Admin Users</a>
                <a href="/admin/profile" id="nav-profile">👤 My Account</a>
            </div>

            <div class="nav-group" style="margin-top: 3rem; border-top: 1px solid #FFF; padding-top: 1rem;">
                <a href="/admin/logout" style="color: #FF0000 !important; border: 2px solid #FF0000; margin: 0 1rem; text-align: center; justify-content: center;">
                    🚪 EXIT SYSTEM
                </a>
            </div>
        </nav>
    </aside>

    <div class="main-content">
        <header class="top-bar">
            <div>
                <span class="fw-black text-white" style="letter-spacing: 1px;">SYSTEM STATUS: <span style="color: var(--brand-green);">OPERATIONAL</span></span>
            </div>

            <div class="d-flex align-items-center gap-4">
                <button class="notification-btn" onclick="window.location.href='/admin/support'">
                    <span>NOTIFICATIONS</span>
                    <div class="red-dot" id="global-dot"></div>
                </button>

                <div class="profile-box">
                    <div class="text-end">
                        <div class="small fw-black text-white"><%= adminUsername %></div>
                        <div class="smaller fw-black" style="color: var(--brand-gold);"><%= role ? role.toUpperCase() : 'STAFF' %></div>
                    </div>
                </div>
            </div>
        </header>

        <main class="content-inner">
            <%- body %>
        </main>
    </div>

    <script>
        // High Contrast Alert System
        function showFlash(title, msg) {
            const el = document.createElement('div');
            el.style.position = 'fixed';
            el.style.bottom = '20px';
            el.style.right = '20px';
            el.style.backgroundColor = '#FF9F0A';
            el.style.color = '#000000';
            el.style.padding = '20px';
            el.style.fontWeight = '900';
            el.style.border = '4px solid #FFFFFF';
            el.style.zIndex = '9999';
            el.innerHTML = `<div>${title.toUpperCase()}</div><div style="font-size: 0.8rem;">${msg}</div>`;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 6000);
        }

        socket.on('new_support_alert', (data) => {
            showFlash('New Support Message', data.body);
            document.getElementById('global-dot').style.display = 'block';
        });

        socket.on('new_kyc_alert', (data) => {
            showFlash('KYC Submission', 'A fulfiller has uploaded documents.');
            document.getElementById('global-dot').style.display = 'block';
        });

        // Active Tab Logic
        const path = window.location.pathname;
        const links = document.querySelectorAll('.sidebar a');
        links.forEach(l => {
            if (path === l.getAttribute('href')) {
                l.classList.add('active-link');
            }
        });
    </script>
</body>
</html>
