<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pikop Command V3 | Mission Control</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script>
        // Global Socket initialization
        const socket = io({ transports: ['websocket'] });
    </script>

    <style>
        :root {
            --gold: #FF9F0A;
            --white: #FFFFFF;
            --black: #000000;
            --red: #FF0000;
            --green: #00FF00;
        }

        body {
            background-color: #000000 !important;
            color: #FFFFFF !important;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Sidebar - Mandatory Visibility Fix */
        .sidebar {
            width: 300px;
            height: 100vh;
            background-color: #000000 !important;
            position: fixed;
            left: 0;
            top: 0;
            border-right: 4px solid #FFFFFF !important;
            z-index: 2000;
            display: flex;
            flex-direction: column;
            overflow-y: scroll; /* Force scrolling for all items */
        }

        .sidebar::-webkit-scrollbar { width: 6px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--gold); }

        .sidebar-header {
            padding: 3rem 1.5rem;
            border-bottom: 2px solid #FFFFFF;
            margin-bottom: 1.5rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 15px;
        }

        .nav-group { margin-bottom: 3rem; }

        .nav-label {
            padding: 0 2rem 0.8rem;
            color: var(--gold) !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 2.5px;
        }

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 18px;
            padding: 1.2rem 2rem;
            color: #FFFFFF !important;
            text-decoration: none;
            font-weight: 900;
            font-size: 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            transition: all 0.2s;
        }

        .sidebar a:hover {
            background-color: rgba(255, 159, 10, 0.15);
            color: var(--gold) !important;
        }

        /* DEFINITIVE ACTIVE TAB HIGHLIGHTING */
        .active-link {
            background-color: var(--gold) !important;
            color: #000000 !important;
            border-right: 12px solid #FFFFFF !important;
            box-shadow: inset -10px 0 20px rgba(0,0,0,0.2);
        }

        .main-content {
            margin-left: 300px;
            min-height: 100vh;
            background-color: #000000 !important;
            padding-bottom: 150px;
        }

        /* Top Bar - High Contrast */
        .top-bar {
            height: 90px;
            background-color: #000000 !important;
            border-bottom: 4px solid #FFFFFF !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 3rem;
            position: sticky;
            top: 0;
            z-index: 1001;
        }

        .notification-btn {
            background: #000;
            border: 3px solid #FFFFFF;
            color: #FFFFFF;
            padding: 10px 20px;
            cursor: pointer;
            position: relative;
            font-weight: 900;
            display: flex;
            align-items: center;
            gap: 15px;
            letter-spacing: 1.5px;
        }

        .notification-btn:hover { background: #FFFFFF; color: #000; }

        .red-dot {
            width: 14px;
            height: 14px;
            background-color: var(--red);
            border-radius: 50%;
            display: none;
            border: 2px solid #FFF;
            box-shadow: 0 0 10px var(--red);
        }

        .profile-box {
            display: flex;
            align-items: center;
            gap: 20px;
            border-left: 2px solid #FFFFFF;
            padding-left: 25px;
        }

        .content-inner { padding: 4rem; }

        /* KPI and Table Hardening */
        .badge-pikop {
            padding: 6px 15px;
            background-color: var(--gold);
            color: #000;
            font-weight: 900;
            border-radius: 2px;
            font-size: 0.8rem;
        }

        /* NO WHITE ON WHITE AUDIT */
        .btn-primary { background-color: var(--gold) !important; color: #000 !important; font-weight: 900 !important; }
        .btn-outline-light { border: 2px solid #FFF !important; color: #FFF !important; font-weight: 900 !important; }
        .card { background-color: #0A0A0A !important; border: 2px solid #FFF !important; border-radius: 0 !important; }

    </style>
</head>
<body>
    <aside class="sidebar" id="sidebar-scroll-box">
        <div class="sidebar-header">
            <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 70px; width: auto;">
            <div class="mt-2"><span class="badge-pikop">CORE v3.5.5</span></div>
        </div>

        <nav>
            <div class="nav-group">
                <div class="nav-label">INTELLIGENCE</div>
                <a href="/admin/dashboard">📊 MISSION CONTROL</a>
                <a href="/admin/reports">📈 ANALYTICS HUB</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">OPERATIONS</div>
                <a href="/admin/orders">📦 LIVE MISSIONS</a>
                <a href="/admin/kyc">🪪 FLEET AUTH</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">PARTNERS</div>
                <a href="/admin/vendors">🏪 MARKETPLACE</a>
                <a href="/admin/kitchens">🍳 KITCHENS</a>
                <a href="/admin/merchants">💼 MERCHANT HUB</a>
            </div>

            <div class="nav-group">
                <div class="nav-label">SYSTEM & SECURITY</div>
                <a href="/admin/support">💬 SUPPORT INBOX</a>
                <a href="/admin/coupons">🎟️ COUPON ENGINE</a>
                <a href="/admin/settings">⚙️ GLOBAL SETTINGS</a>
                <a href="/admin/users">👥 ADMIN USERS</a>
                <a href="/admin/profile">👤 MY PROFILE</a>
            </div>

            <div class="nav-group" style="padding-bottom: 50px;">
                <div class="nav-label">SESSION</div>
                <a href="/admin/logout" style="color: #FF0000 !important; border: 3px solid #FF0000; margin: 0 1rem; text-align: center; justify-content: center; background: rgba(255,0,0,0.1);">
                    🚪 EXIT SYSTEM
                </a>
            </div>
        </nav>
    </aside>

    <div class="main-content">
        <header class="top-bar">
            <div>
                <span class="fw-black text-white" style="letter-spacing: 2px; font-size: 1.1rem;">PIKOP STATUS: <span style="color: var(--green);">OPERATIONAL</span></span>
            </div>

            <div class="d-flex align-items-center gap-4">
                <button class="notification-btn" onclick="window.location.href='/admin/support'">
                    <span>SYSTEM ALERTS</span>
                    <div class="red-dot" id="global-dot"></div>
                </button>

                <div class="profile-box">
                    <div class="text-end">
                        <div class="fw-black text-white" style="font-size: 1rem;"><%= adminUsername %></div>
                        <div class="fw-black" style="color: var(--gold); font-size: 0.75rem; letter-spacing: 1.5px;"><%= role ? role.toUpperCase() : 'STAFF' %></div>
                    </div>
                    <div class="rounded-circle bg-primary text-black fw-black d-flex align-items-center justify-content-center shadow-lg" style="width: 45px; height: 45px; border: 3px solid white; font-size: 1.2rem;">OP</div>
                </div>
            </div>
        </header>

        <main class="content-inner">
            <%- body %>
        </main>
    </div>

    <script>
        // Definitive High Contrast Notifications
        function flashAlert(title, msg) {
            const el = document.createElement('div');
            el.style.cssText = 'position:fixed; bottom:40px; right:40px; background:#FF9F0A; color:#000; padding:30px; font-weight:900; border:6px solid #FFF; z-index:9999; box-shadow: 0 0 50px rgba(255,159,10,0.5);';
            el.innerHTML = `<div style="font-size:1.2rem; margin-bottom:10px;">${title.toUpperCase()}</div><div style="font-size:0.9rem;">${msg}</div>`;
            document.body.appendChild(el);
            setTimeout(() => el.remove(), 8000);
        }

        socket.on('new_support_alert', (data) => {
            flashAlert('NEW MESSAGE', data.body);
            document.getElementById('global-dot').style.display = 'block';
        });

        socket.on('new_kyc_alert', (data) => {
            flashAlert('KYC UPLOAD', 'A new document requires authentication.');
            document.getElementById('global-dot').style.display = 'block';
        });

        // HIGH CONTRAST ACTIVE LINK DETECTION
        const path = window.location.pathname;
        const navLinks = document.querySelectorAll('.sidebar a');
        navLinks.forEach(link => {
            if (path === link.getAttribute('href')) {
                link.classList.add('active-link');
                // Ensure parent group is visible (if we had collapsible)
            }
        });
    </script>
</body>
</html>
