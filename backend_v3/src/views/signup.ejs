<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIKOP COMMAND | INITIAL SETUP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --green: #008751;
            --gold: #FFC618;
            --white: #FFFFFF;
            --black: #1A1A1A;
            --grey: #E0E0E0;
        }
        body {
            background-color: var(--white) !important;
            color: var(--black) !important;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            margin: 0;
        }
        .setup-card {
            background: var(--white) !important;
            padding: 4rem 3rem;
            border-radius: 12px;
            width: 100%;
            max-width: 450px;
            border: 1px solid var(--grey) !important;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
        }
        .form-control {
            background: var(--white) !important;
            border: 1px solid var(--grey) !important;
            color: var(--black) !important;
            padding: 0.85rem 1.25rem;
            font-weight: 500;
            border-radius: 6px;
            font-size: 15px;
        }
        .form-label {
            color: var(--black) !important;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 2px;
            margin-bottom: 12px;
            display: block;
            opacity: 0.8;
        }
        .btn-primary {
            background: var(--green) !important;
            border: none;
            color: var(--white) !important;
            font-weight: 800;
            padding: 1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 25px;
            border-radius: 6px;
            width: 100%;
            font-size: 14px;
        }
        .brand-logo { height: 50px; width: auto; margin-bottom: 35px; }
    </style>
</head>
<body>
    <div class="setup-card text-center">
        <img src="/public/assets/logo.png" alt="Pikop Logo" class="brand-logo">
        <div style="font-size: 13px; font-weight: 800; color: var(--green); letter-spacing: 3px; margin-bottom: 25px; text-transform: uppercase;">INITIAL COMMAND SETUP</div>
        <p class="text-muted small mb-4">Create the first super administrator account to initialize the system.</p>

        <form action="/admin/signup" method="POST">
            <div class="mb-4 text-start">
                <label class="form-label">CHOOSE USERNAME</label>
                <input type="text" name="username" class="form-control" required autocomplete="off">
            </div>
            <div class="mb-5 text-start">
                <label class="form-label">SET SECURE PASSWORD</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">INITIALIZE CORE</button>
        </form>
    </div>
</body>
</html>
