<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Merchant Hub</h4>
    <p class="text-muted small mb-0">High-volume logistics, vendors, kitchens, and API-driven business accounts.</p>
</div>

<div class="card-pikop p-5 text-center">
    <div class="mb-4">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width: 56px; height: 56px; color: var(--green); opacity: 0.8;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
    </div>
    <h5 class="text-black fw-bold mb-3">Merchant Infrastructure Operational</h5>
    <p class="text-muted small mb-5 max-width-500 mx-auto">Bulk ordering via API Key and JSON/CSV is active. Business accounts can deploy multiple missions simultaneously.</p>

    <div class="d-flex justify-content-center gap-3">
        <a href="/admin/vendors" class="btn-pikop-primary px-4 text-decoration-none">MANAGE VENDORS</a>
        <a href="/admin/kitchens" class="btn-pikop-outline px-4 text-decoration-none">MANAGE KITCHENS</a>
    </div>
</div>

<div class="mt-5 mb-3">
    <h5 class="fw-bold text-black">Merchant Registry & Verification Queue</h5>
</div>

<div class="card-pikop">
    <% if (merchants.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No merchant profiles found in the system.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Merchant</th>
                        <th class="text-center">Type</th>
                        <th class="text-center">Category</th>
                        <th class="text-center">COD</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% merchants.forEach(m => { %>
                        <tr class="align-middle">
                            <td class="fw-bold text-black"><%= m.business_name %></td>
                            <td class="text-center small text-uppercase fw-bold text-muted"><%= m.type %></td>
                            <td class="text-center"><%= m.category %></td>
                            <td class="text-center">
                                <span class="badge <%= m.accepts_cod ? 'bg-success' : 'bg-secondary' %> text-white">
                                    <%= m.accepts_cod ? 'YES' : 'NO' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= m.status === 'active' ? 'bg-green' : m.status === 'suspended' ? 'bg-warning text-dark' : 'bg-danger' %> text-white fw-bold px-3">
                                    <%= m.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <% if (m.status !== 'active') { %>
                                        <form action="/admin/merchants/<%= m.type %>/<%= m.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="VERIFIED">
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 11px;">APPROVE</button>
                                        </form>
                                    <% } %>
                                    <% if (m.status !== 'suspended') { %>
                                        <form action="/admin/merchants/<%= m.type %>/<%= m.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="suspended">
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size: 11px;">SUSPEND</button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/merchants/<%= m.type %>/<%= m.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete merchant and all products/menu items?')">
                                        <button type="submit" class="btn btn-sm btn-danger py-0 px-2" style="font-size: 11px;">DELETE</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .max-width-500 { max-width: 500px; }
    .bg-green { background-color: var(--green) !important; }
</style>
