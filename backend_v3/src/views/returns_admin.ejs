<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Marketplace Returns & Disputes</h2>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th>Fee Payer</th>
                        <th>Requested Date</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (returnsList.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No return requests recorded.</td>
                        </tr>
                    <% } else { %>
                        <% returnsList.forEach(ret => { %>
                            <tr>
                                <td><strong>#<%= ret.order_id %></strong></td>
                                <td>
                                    <%= ret.customer_name %>
                                    <div class="small text-muted"><%= ret.customer_phone %></div>
                                </td>
                                <td>
                                    <strong><%= ret.reason %></strong>
                                    <% if (ret.merchant_notes) { %>
                                        <div class="small text-muted">Merchant Note: <%= ret.merchant_notes %></div>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="badge bg-<%= ret.status === 'APPROVED' || ret.status === 'COMPLETED' ? 'success' : (ret.status === 'DECLINED' ? 'danger' : 'warning') %>">
                                        <%= ret.status %>
                                    </span>
                                </td>
                                <td><span class="badge bg-secondary"><%= ret.delivery_fee_payer %></span></td>
                                <td class="small text-muted"><%= new Date(ret.created_at).toLocaleString() %></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
