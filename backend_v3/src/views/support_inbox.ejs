<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Support Command</h4>
    <p class="text-muted small mb-0">Active communication with users and fleet.</p>
</div>

<div class="card-pikop">
    <% if (conversations.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No active support sessions found.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>User Type</th>
                        <th class="text-center">Last Active</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% conversations.forEach(conv => { %>
                        <tr class="align-middle clickable-row" onclick="window.location.href='/admin/support/<%= conv.id %>'">
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center position-relative" style="width: 35px; height: 35px; border: 1px solid var(--border);">
                                        <span class="fw-bold text-green small"><%= conv.participant_name.charAt(0) %></span>
                                        <% if (conv.unread_count > 0) { %>
                                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 8px;">
                                                <%= conv.unread_count %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <span class="fw-bold text-black"><%= conv.participant_name %></span>
                                </div>
                            </td>
                            <td><span class="badge bg-gold text-black fw-bold" style="font-size: 10px;"><%= conv.participant_type %></span></td>
                            <td class="text-center text-black small"><%= new Date(conv.last_message_at).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) %></td>
                            <td class="text-end">
                                <span class="text-green fw-bold small">Open Session &rarr;</span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .clickable-row { cursor: pointer; transition: all 0.2s ease; }
    .clickable-row:hover { background-color: rgba(0, 135, 81, 0.05) !important; }
    .bg-gold { background-color: var(--gold) !important; }
    .text-green { color: var(--green) !important; }
</style>
