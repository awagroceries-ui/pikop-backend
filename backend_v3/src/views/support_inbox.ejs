<div class="mb-5">
    <h4 class="fw-bold mb-1 text-white">Support Command</h4>
    <p class="text-white opacity-50 small mb-0">Active communication with users and fleet.</p>
</div>

<div class="card-pikop">
    <% if (conversations.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-white opacity-50 mb-0">No active support sessions found.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>User Type</th>
                        <th class="text-center">Last Active</th>
                        <th class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% conversations.forEach(conv => { %>
                        <tr class="align-middle clickable-row" onclick="window.location.href='/admin/support/<%= conv.id %>'">
                            <td><span class="fw-bold text-white"><%= conv.participant_name %></span></td>
                            <td><span class="badge bg-gold text-black fw-bold" style="font-size: 10px;"><%= conv.participant_type %></span></td>
                            <td class="text-center text-white opacity-75 small"><%= new Date(conv.last_message_at).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' }) %></td>
                            <td class="text-end">
                                <span class="text-gold fw-bold small">Open Session &rarr;</span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .clickable-row { cursor: pointer; }
    .clickable-row:hover { background-color: #111 !important; }
</style>
