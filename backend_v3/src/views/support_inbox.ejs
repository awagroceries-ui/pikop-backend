<div class="mb-5">
    <h3 class="fw-black mb-1 ls-1 text-white">SUPPORT COMMAND</h3>
    <p class="text-white opacity-75 small fw-bold">Manage real-time communication with users and fleet.</p>
</div>

<div class="row g-4">
    <% if (conversations.length === 0) { %>
        <div class="col-12">
            <div class="card p-5 text-center" style="background: #000; border: 3px solid #FFF;">
                <p class="text-white fw-black mb-0">NO ACTIVE SUPPORT SESSIONS FOUND.</p>
            </div>
        </div>
    <% } else { %>
        <% conversations.forEach(conv => { %>
            <div class="col-md-12">
                <a href="/admin/support/<%= conv.id %>" class="text-decoration-none">
                    <div class="card p-4 transition-hover" style="background: #0A0A0A; border: 2px solid #FFF;">
                        <div class="row align-items-center">
                            <div class="col-md-4">
                                <h5 class="mb-1 text-white fw-black"><%= conv.participant_name.toUpperCase() %></h5>
                                <span class="badge bg-primary text-black fw-black"><%= conv.participant_type %></span>
                            </div>
                            <div class="col-md-4 text-center">
                                <span class="text-white opacity-75 small ls-1 fw-black">LAST ACTIVE</span>
                                <div class="text-white fw-black"><%= new Date(conv.last_message_at).toLocaleString() %></div>
                            </div>
                            <div class="col-md-4 text-end">
                                <span class="text-primary fw-black ls-1">OPEN SESSION <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" class="ms-1"><path d="M9 5l7 7-7 7"></path></svg></span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        <% }) %>
    <% } %>
</div>

<style>
    .transition-hover { transition: 0.2s transform ease; }
    .transition-hover:hover { transform: translateX(10px); border-color: var(--brand-gold) !important; }
</style>
