<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="/admin/support" class="text-muted">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        </a>
        <div>
            <h4 class="mb-0 fw-bold">Session: <%= conversation.participant_name %></h4>
            <span class="text-muted small mono uppercase ls-1">Live Encryption Active</span>
        </div>
    </div>
</div>

<div class="card bg-card border-0 d-flex flex-column shadow-lg" style="height: 65vh; border-radius: 20px;">
    <div id="chat-window" class="card-body overflow-auto p-4 d-flex flex-column gap-3" style="background: rgba(0,0,0,0.2);">
        <% messages.forEach(msg => { %>
            <div class="d-flex <%= msg.sender_type === 'ADMIN' ? 'justify-content-end' : 'justify-content-start' %>">
                <div class="p-3 rounded-4" style="max-width: 75%; background: <%= msg.sender_type === 'ADMIN' ? 'var(--brand-gold)' : 'rgba(255,255,255,0.05)' %>; color: <%= msg.sender_type === 'ADMIN' ? 'black' : 'white' %>; border: 1px solid rgba(255,255,255,0.05);">
                    <p class="mb-1" style="font-size: 0.95rem; line-height: 1.5;"><%= msg.content %></p>
                    <div class="text-end" style="font-size: 0.6rem; opacity: 0.5; margin-top: 4px;">
                        <%= new Date(msg.created_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="card-footer p-4 border-top border-white border-opacity-5">
        <div class="input-group">
            <input type="text" id="msg-input" class="form-control bg-dark border-0 text-white p-3" placeholder="Secure response..." style="border-radius: 12px 0 0 12px;">
            <button class="btn btn-primary px-4 fw-black" id="send-btn" style="border-radius: 0 12px 12px 0;">TRANSMIT</button>
        </div>
    </div>
</div>

<script>
    const convId = "<%= conversation.id %>";
    const adminId = "<%= adminId %>";
    const chatWindow = document.getElementById('chat-window');
    const msgInput = document.getElementById('msg-input');
    const sendBtn = document.getElementById('send-btn');

    socket.emit('join_support', convId);

    socket.on('receive_message', (msg) => {
        if (msg.conversation_id === convId) {
            appendMessage(msg);
            chatWindow.scrollTop = chatWindow.scrollHeight;
        }
    });

    function appendMessage(msg) {
        const isMe = msg.sender_type === 'ADMIN';
        const div = document.createElement('div');
        div.className = `d-flex ${isMe ? 'justify-content-end' : 'justify-content-start'}`;
        div.innerHTML = `
            <div class="p-3 rounded-4" style="max-width: 75%; background: ${isMe ? 'var(--brand-gold)' : 'rgba(255,255,255,0.05)'}; color: ${isMe ? 'black' : 'white'}; border: 1px solid rgba(255,255,255,0.05);">
                <p class="mb-1" style="font-size: 0.95rem; line-height: 1.5;">${msg.content}</p>
                <div class="text-end" style="font-size: 0.6rem; opacity: 0.5; margin-top: 4px;">Just Now</div>
            </div>
        `;
        chatWindow.appendChild(div);
    }

    sendBtn.onclick = () => {
        const content = msgInput.value.trim();
        if (!content) return;

        socket.emit('send_message', {
            conversation_id: convId,
            sender_id: adminId,
            sender_type: 'ADMIN',
            content: content
        });

        msgInput.value = '';
    };

    msgInput.onkeypress = (e) => {
        if (e.key === 'Enter') sendBtn.click();
    };

    // Auto-scroll
    chatWindow.scrollTop = chatWindow.scrollHeight;
</script>
