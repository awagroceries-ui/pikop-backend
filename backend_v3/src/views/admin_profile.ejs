<div class="mb-5">
    <h4 class="fw-bold mb-1 text-white">Security Identity</h4>
    <p class="text-white opacity-50 small mb-0">Manage your administrative credentials and access profile.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-pikop p-5">
            <div class="d-flex align-items-center gap-4 mb-5">
                <div class="rounded-circle bg-black border border-white d-flex align-items-center justify-content-center fw-bold" style="width: 70px; height: 70px; font-size: 20px; color: var(--gold);">
                    OP
                </div>
                <div>
                    <h4 class="fw-bold text-white mb-1"><%= user.username %></h4>
                    <span class="badge bg-gold text-black fw-bold px-3" style="font-size: 10px;"><%= user.role.toUpperCase() %></span>
                </div>
            </div>

            <hr class="border-white opacity-10 mb-5">

            <form>
                <div class="mb-4">
                    <label class="text-white small fw-bold uppercase mb-2 d-block" style="font-size: 11px; opacity: 0.7;">Current Username</label>
                    <input type="text" class="form-control bg-black border-white border-opacity-25 text-white fw-bold" value="<%= user.username %>" readonly style="border-radius: 4px;">
                </div>
                <div class="mb-5">
                    <label class="text-white small fw-bold uppercase mb-2 d-block" style="font-size: 11px; opacity: 0.7;">New Security Key</label>
                    <input type="password" class="form-control bg-black border-white border-opacity-25 text-white" placeholder="••••••••" style="border-radius: 4px;">
                </div>
                <button type="button" class="btn-pikop-primary w-100 py-3">UPDATE IDENTITY PROFILE</button>
            </form>
        </div>
    </div>
</div>
