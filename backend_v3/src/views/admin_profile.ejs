<div class="mb-5">
    <h3 class="fw-black mb-1 ls-1 text-white">MY OPERATIONAL PROFILE</h3>
    <p class="text-white opacity-75 small fw-bold">Manage your security credentials and administrative identity.</p>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card p-5" style="background: #000; border: 3px solid #FFF;">
            <div class="d-flex align-items-center gap-5 mb-5">
                <div class="rounded-circle bg-primary text-black fw-black d-flex align-items-center justify-content-center shadow-lg" style="width: 100px; height: 100px; font-size: 2.5rem; border: 4px solid white;">OP</div>
                <div>
                    <h1 class="fw-black text-white mb-2 ls-1"><%= user.username.toUpperCase() %></h1>
                    <span class="badge bg-gold text-black fw-black px-4 py-2" style="font-size: 1rem;"><%= user.role.toUpperCase() %></span>
                </div>
            </div>

            <hr class="border-white opacity-20 mb-5">

            <form>
                <div class="mb-4">
                    <label class="form-label text-white fw-black small ls-2">CURRENT IDENTITY</label>
                    <input type="text" class="form-control bg-black border-white text-white fw-black py-3" value="<%= user.username.toUpperCase() %>" readonly style="border-radius: 0; border-width: 2px;">
                </div>
                <div class="mb-5">
                    <label class="form-label text-white fw-black small ls-2">NEW SECURITY KEY</label>
                    <input type="password" class="form-control bg-black border-white text-white fw-black py-3" placeholder="ENTER NEW PASSWORD" style="border-radius: 0; border-width: 2px;">
                </div>
                <button type="button" class="btn btn-primary w-100 fw-black ls-1 py-3">UPDATE SECURITY CREDENTIALS</button>
            </form>
        </div>
    </div>
</div>

<style>
    .ls-2 { letter-spacing: 2px; }
</style>
