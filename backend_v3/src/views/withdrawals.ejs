<div class="mb-5 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold mb-1 text-black" style="letter-spacing: -0.5px;">Payout Control</h3>
        <p class="text-muted small mb-0">Approve and process fulfiller withdrawal requests via Paystack Transfer.</p>
    </div>
    <% if (withdrawals.length > 0) { %>
        <button class="btn btn-sm btn-success fw-bold py-2 px-3" onclick="triggerBatchPayouts()">⚡ BATCH APPROVE ALL PAYOUTS (<%= withdrawals.length %>)</button>
    <% } %>
</div>

<div class="card-pikop">
    <% if (withdrawals.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No pending withdrawal requests found.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Fulfiller</th>
                        <th>Amount</th>
                        <th>Bank Details</th>
                        <th>Requested</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% withdrawals.forEach(w => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= w.fulfiller_name %></div>
                                <div class="smaller text-muted">ID: #<%= w.fulfiller_id %></div>
                            </td>
                            <td>
                                <div class="text-green fw-bold">₦<%= parseFloat(w.amount).toLocaleString() %></div>
                            </td>
                            <td>
                                <div class="small fw-bold"><%= w.bank_name %></div>
                                <div class="mono smaller"><%= w.account_number %></div>
                                <div class="smaller text-muted"><%= w.account_name %></div>
                                <% if (w.paystack_recipient_code) { %>
                                    <span class="badge bg-light text-muted border" style="font-size: 8px;">VERIFIED: <%= w.paystack_recipient_code %></span>
                                <% } %>
                            </td>
                            <td>
                                <div class="smaller text-muted"><%= new Date(w.requested_at).toLocaleString() %></div>
                            </td>
                            <td class="text-end">
                                <form action="/admin/withdrawals/<%= w.id %>/approve" method="POST" onsubmit="return confirm('Initiate real-money transfer to <%= w.fulfiller_name %>?')">
                                    <button type="submit" class="btn-pikop-primary py-1 px-3" style="font-size: 11px;">APPROVE & TRANSFER</button>
                                </form>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<script>
    function triggerBatchPayouts() {
        if (confirm("Are you sure you want to batch approve and process all pending payout requests?")) {
            fetch('/admin/withdrawals/batch-approve', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message || 'Batch payouts processed successfully!');
                window.location.reload();
            })
            .catch(e => alert('Batch payout failed: ' + e.message));
        }
    }
</script>

<style>
    .text-green { color: var(--green) !important; }
    .mono { font-family: 'JetBrains Mono', monospace; }
</style>
