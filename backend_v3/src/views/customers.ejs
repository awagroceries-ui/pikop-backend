<div class="mb-5">
    <h3 class="fw-bold mb-1 text-black" style="letter-spacing: -0.5px;">Customer Directory</h3>
    <p class="text-muted small">Manage customer accounts, inspect wallet balances, and view operational history.</p>
</div>

<div class="row g-4">
    <div class="col-12">
        <div class="card-pikop p-4">
            <% if (customers.length === 0) { %>
                <div class="p-5 text-center text-muted">No customers found.</div>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th class="smaller uppercase text-muted">Customer</th>
                                <th class="smaller uppercase text-muted">Phone</th>
                                <th class="smaller uppercase text-muted">Wallet Balance</th>
                                <th class="smaller uppercase text-muted">Status</th>
                                <th class="smaller uppercase text-muted text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% customers.forEach(c => { %>
                                <tr>
                                    <td>
                                        <div class="fw-bold text-black"><%= c.full_name %></div>
                                        <div class="small text-muted"><%= c.email %></div>
                                    </td>
                                    <td>
                                        <div class="small mono"><%= c.phone || 'N/A' %></div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-green mono">₦<%= parseFloat(c.balance || 0).toLocaleString() %></div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">ACTIVE</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/admin/customers/<%= c.id %>" class="btn btn-sm btn-outline-primary py-0 px-3" style="font-size: 11px; text-decoration: none;">VIEW PROFILE</a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
