<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h4 class="fw-bold mb-1 text-black">Traffic Management</h4>
        <p class="text-muted small mb-0">Configure rush-hour multipliers for known congestion corridors.</p>
    </div>
    <button class="btn-pikop-primary" data-bs-toggle="modal" data-bs-target="#addCorridorModal">ADD NEW CORRIDOR</button>
</div>

<div class="card-pikop">
    <% if (corridors.length === 0) { %>
        <div class="p-5 text-center text-muted">No traffic corridors defined.</div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Corridor Name</th>
                        <th>Route</th>
                        <th class="text-center">Surcharge</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% corridors.forEach(c => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= c.name %></div>
                                <div class="smaller text-muted"><%= (c.time_windows || []).length %> windows configured</div>
                            </td>
                            <td>
                                <div class="small">
                                    <span class="text-muted">From:</span> <%= zones.find(z => z.id === c.pickup_zone_id)?.name || 'Any' %><br>
                                    <span class="text-muted">To:</span> <%= zones.find(z => z.id === c.delivery_zone_id)?.name || 'Any' %>
                                </div>
                            </td>
                            <td class="text-center fw-bold text-danger">
                                x<%= c.time_windows[0]?.multiplier || '1.0' %>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= c.is_active ? 'bg-success' : 'bg-secondary' %>">
                                    <%= c.is_active ? 'ACTIVE' : 'PAUSED' %>
                                </span>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-light border">EDIT</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- Modal -->
<div class="modal fade" id="addCorridorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-bold">New Traffic Corridor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/admin/traffic" method="POST">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="small fw-bold mb-1">Corridor Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Third Mainland Bridge Rush" required>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="small fw-bold mb-1">Pickup Zone</label>
                            <select name="pickup_zone_id" class="form-select" required>
                                <% zones.forEach(z => { %><option value="<%= z.id %>"><%= z.name %></option><% }) %>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="small fw-bold mb-1">Delivery Zone</label>
                            <select name="delivery_zone_id" class="form-select" required>
                                <% zones.forEach(z => { %><option value="<%= z.id %>"><%= z.name %></option><% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="small fw-bold mb-1">Multiplier</label>
                            <input type="number" step="0.1" name="multiplier" class="form-control" value="1.5" required>
                        </div>
                        <div class="col-4">
                            <label class="small fw-bold mb-1">Start Time</label>
                            <input type="time" name="start_time" class="form-control" value="07:00" required>
                        </div>
                        <div class="col-4">
                            <label class="small fw-bold mb-1">End Time</label>
                            <input type="time" name="end_time" class="form-control" value="10:00" required>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="submit" class="btn-pikop-primary w-100 py-3">ACTIVATE CORRIDOR</button>
                </div>
            </form>
        </div>
    </div>
</div>
