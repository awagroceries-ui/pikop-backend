<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Kitchen Partners</h4>
    <p class="text-muted small mb-0">Management of Foods & Meals kitchen operations, status, and store deletion.</p>
</div>

<div class="card-pikop">
    <% if (kitchens.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No active kitchens found. Ready for Food module rollout.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Kitchen Entity</th>
                        <th class="text-center">Category/Cuisine</th>
                        <th class="text-center">Accepts COD</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% kitchens.forEach(k => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= k.business_name %></div>
                                <div class="smaller text-muted">Owner: <%= k.contact_person %> (<%= k.contact_email %>)</div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-black border fw-bold small uppercase"><%= k.category %> / <%= k.cuisine_type || 'GENERAL' %></span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= k.accepts_cod ? 'bg-success' : 'bg-secondary' %> text-white">
                                    <%= k.accepts_cod ? 'YES' : 'NO' %>
                                </span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= k.status === 'active' ? 'bg-green' : k.status === 'suspended' ? 'bg-warning text-dark' : 'bg-danger' %> text-white fw-bold px-3">
                                    <%= k.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2 align-items-center">
                                    <% if (k.status !== 'active') { %>
                                        <form action="/admin/merchants/kitchen/<%= k.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="VERIFIED">
                                            <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" style="font-size: 11px;">APPROVE</button>
                                        </form>
                                    <% } %>
                                    <% if (k.status !== 'suspended') { %>
                                        <form action="/admin/merchants/kitchen/<%= k.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="suspended">
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size: 11px;">SUSPEND</button>
                                        </form>
                                    <% } %>
                                    <% if (k.status !== 'banned') { %>
                                        <form action="/admin/merchants/kitchen/<%= k.id %>/status" method="POST" class="d-inline">
                                            <input type="hidden" name="status" value="banned">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary py-0 px-2" style="font-size: 11px;">BAN</button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/merchants/kitchen/<%= k.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Delete kitchen and all menu items?')">
                                        <button type="submit" class="btn btn-sm btn-danger py-0 px-2" style="font-size: 11px;">DELETE</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
</style>
