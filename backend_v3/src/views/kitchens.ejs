<div class="mb-5">
    <h3 class="fw-extrabold mb-1 ls-1">Kitchen Partners</h3>
    <p class="text-muted small">Manage Foods & Meals kitchen operations.</p>
</div>

<div class="row g-4">
    <% if (kitchens.length === 0) { %>
        <div class="col-12">
            <div class="card bg-card border-0 p-5 text-center">
                <p class="text-muted mb-0">No active kitchens found. Ready for Food module rollout.</p>
            </div>
        </div>
    <% } else { %>
        <% kitchens.forEach(k => { %>
            <div class="col-md-12">
                <div class="card bg-card border-0 p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4">
                            <h6 class="mb-1 text-white fw-bold"><%= k.business_name %></h6>
                            <span class="badge bg-teal text-white smaller uppercase"><%= k.cuisine_type || 'General' %></span>
                        </div>
                        <div class="col-md-3">
                            <span class="badge <%= k.status === 'active' ? 'bg-success' : 'bg-warning text-dark' %>">
                                <%= k.status.toUpperCase() %>
                            </span>
                        </div>
                        <div class="col-md-5 text-end">
                            <button class="btn btn-sm btn-outline-secondary px-3">Menu</button>
                            <button class="btn btn-sm btn-outline-primary px-3 ms-2">Edit</button>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<style>
    .bg-teal { background-color: #00BCD4; }
</style>
