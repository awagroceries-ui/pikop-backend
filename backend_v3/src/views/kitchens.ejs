<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">Kitchen Partners</h4>
    <p class="text-muted small mb-0">Management of Foods & Meals kitchen operations.</p>
</div>

<div class="card-pikop">
    <% if (kitchens.length === 0) { %>
        <div class="p-5 text-center">
            <p class="text-muted mb-0">No active kitchens found. Ready for Food module rollout.</p>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table-pikop">
                <thead>
                    <tr>
                        <th>Kitchen Entity</th>
                        <th class="text-center">Cuisine</th>
                        <th class="text-center">Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% kitchens.forEach(k => { %>
                        <tr class="align-middle">
                            <td>
                                <div class="fw-bold text-black"><%= k.business_name %></div>
                                <div class="smaller text-muted"><%= k.contact_email %></div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-black border fw-bold small uppercase"><%= k.cuisine_type || 'GENERAL' %></span>
                            </td>
                            <td class="text-center">
                                <span class="badge <%= k.status === 'active' ? 'bg-green' : 'bg-gold' %> text-white fw-bold px-3">
                                    <%= k.status.toUpperCase() %>
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn-pikop-outline py-1 px-3" style="font-size: 11px;">MENU</button>
                                    <button class="btn-pikop-primary py-1 px-3" style="font-size: 11px;">EDIT</button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<style>
    .bg-green { background-color: var(--green) !important; }
    .bg-gold { background-color: var(--gold) !important; color: var(--black) !important; }
</style>
