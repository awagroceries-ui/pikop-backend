<div class="mb-5">
    <a href="/admin/kyc" class="btn btn-sm btn-outline-secondary mb-3">← Back to Queue</a>
    <h4 class="fw-bold mb-1 text-black">Review Fulfiller: <%= f.full_name %></h4>
    <p class="text-muted small mb-0">Verify identity and operational documents for activation.</p>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card-pikop p-4 mb-4">
            <h6 class="fw-bold mb-3 border-bottom pb-2">Individual Identity (Didit/Prembly)</h6>
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="text-muted smaller fw-bold uppercase d-block">Session ID</label>
                    <div class="text-black small"><%= f.didit_session_id || 'N/A' %></div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted smaller fw-bold uppercase d-block">Verification Status</label>
                    <span class="badge <%= f.didit_verification_status === 'approved' ? 'bg-success' : 'bg-warning' %>">
                        <%= (f.didit_verification_status || 'PENDING').toUpperCase() %>
                    </span>
                </div>
                <div class="col-md-4 text-end">
                    <% if (f.profile_photo_url) { %>
                        <img src="<%= f.profile_photo_url.startsWith('http') ? f.profile_photo_url : baseUrl + f.profile_photo_url %>" class="rounded border" style="width: 80px; height: 80px; object-fit: cover;">
                    <% } else { %>
                        <div class="bg-light rounded border d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <span class="text-muted smaller">No Photo</span>
                        </div>
                    <% } %>
                </div>
            </div>

            <% if (f.kyc_details) { %>
                <div class="mt-4 p-3 border rounded bg-light">
                    <h6 class="smaller fw-bold text-muted uppercase mb-3">Automated Identity Report (Prembly)</h6>
                    <div class="row g-3">
                        <% if (typeof f.kyc_details === 'object' && f.kyc_details !== null) { %>
                            <%
                                const report = f.kyc_details;
                                // Handle varying Prembly response structures
                                const data = report.data || report;
                                const firstName = data.first_name || data.firstName;
                                const lastName = data.last_name || data.lastName;
                                const dob = data.dob || data.dateOfBirth;
                                const status = report.status || report.message;
                            %>

                            <div class="col-md-6">
                                <span class="text-muted smaller d-block">Verified Name</span>
                                <span class="small fw-bold text-black"><%= firstName %> <%= lastName %></span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted smaller d-block">Verified DOB</span>
                                <span class="small fw-bold text-black"><%= dob || 'N/A' %></span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted smaller d-block">Verification Status</span>
                                <span class="badge bg-success smaller uppercase"><%= status %></span>
                            </div>
                            <div class="col-md-6">
                                <span class="text-muted smaller d-block">Reference</span>
                                <span class="mono smaller text-muted"><%= report.reference || 'prembly_v3' %></span>
                            </div>

                            <!-- Detailed Breakdown Toggle -->
                            <div class="col-12 mt-3 pt-3 border-top">
                                <button class="btn btn-link btn-sm p-0 smaller text-decoration-none" type="button" data-bs-toggle="collapse" data-bs-target="#kycRaw">
                                    Show Technical Data (JSON) ↓
                                </button>
                                <div class="collapse mt-2" id="kycRaw">
                                    <pre class="bg-dark text-success p-3 rounded smaller" style="max-height: 250px; overflow-y: auto; font-size: 10px;"><code><%= JSON.stringify(f.kyc_details, null, 2) %></code></pre>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="col-12 small text-muted"><%= f.kyc_details %></div>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="card-pikop p-4">
            <h6 class="fw-bold mb-3 border-bottom pb-2">Operational Documents</h6>
            <% if (docs.length === 0) { %>
                <p class="text-muted small italic">No additional documents uploaded.</p>
            <% } else { %>
                <div class="row g-3">
                    <% docs.forEach(doc => { %>
                        <div class="col-md-6">
                            <div class="border rounded p-3 bg-light">
                                <label class="text-muted smaller fw-bold uppercase d-block mb-2"><%= doc.doc_type.replace('_', ' ') %></label>
                                <a href="<%= doc.file_url.startsWith('http') ? doc.file_url : baseUrl + doc.file_url %>" target="_blank" class="btn btn-sm btn-pikop-outline w-100 mb-2">VIEW DOCUMENT</a>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-secondary smaller"><%= doc.status %></span>
                                    <span class="smaller text-muted">Expires: <%= doc.expiry_date ? new Date(doc.expiry_date).toLocaleDateString() : 'N/A' %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card-pikop p-4 sticky-top" style="top: 100px;">
            <h6 class="fw-bold mb-3">System Action</h6>

            <div class="mb-4">
                <label class="text-muted smaller fw-bold uppercase d-block mb-1">Email</label>
                <div class="text-black fw-bold"><%= f.email %></div>
            </div>

            <div class="mb-4">
                <label class="text-muted smaller fw-bold uppercase d-block mb-1">Phone</label>
                <div class="text-black fw-bold"><%= f.user_phone %></div>
            </div>

            <div class="mb-4">
                <label class="text-muted smaller fw-bold uppercase d-block mb-1">Fulfiller Class</label>
                <div class="text-black fw-bold uppercase"><%= f.primary_class %></div>
            </div>

            <form action="/admin/kyc/<%= f.id %>/status" method="POST">
                <div class="mb-3">
                    <label class="small fw-bold mb-1">Internal Note (Optional)</label>
                    <textarea name="note" class="form-control form-control-sm" rows="3" placeholder="Reason for rejection or special approval note..."></textarea>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" name="status" value="VERIFIED" class="btn-pikop-primary">APPROVE APPLICATION</button>
                    <button type="submit" name="status" value="REJECTED" class="btn btn-outline-danger fw-bold border-2">REJECT APPLICATION</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 11px; }
    .btn-pikop-outline { font-size: 11px; }
</style>
