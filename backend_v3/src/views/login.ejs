<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIKOP COMMAND | AUTHORIZED ACCESS ONLY</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #000000 !important;
            color: #FFFFFF !important;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            margin: 0;
        }
        .login-card {
            background: #000000 !important;
            padding: 4rem;
            border-radius: 0;
            width: 100%;
            max-width: 450px;
            border: 5px solid #FF9F0A !important;
            box-shadow: 0 0 60px rgba(255, 159, 10, 0.3);
        }
        .form-control {
            background: #000000 !important;
            border: 3px solid #FFFFFF !important;
            color: #FFFFFF !important;
            padding: 1.2rem;
            font-weight: 900;
            border-radius: 0;
            font-size: 1.2rem;
            text-transform: uppercase;
        }
        .form-control:focus {
            border-color: #FF9F0A !important;
            box-shadow: 0 0 15px #FF9F0A;
            outline: none;
        }
        .form-label {
            color: #FFFFFF !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 1rem;
            letter-spacing: 3px;
            margin-bottom: 15px;
            display: block;
        }
        .btn-primary {
            background: #FF9F0A !important;
            border: none;
            color: #000000 !important;
            font-weight: 900;
            padding: 1.5rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-top: 30px;
            border-radius: 0;
            width: 100%;
            font-size: 1.1rem;
        }
        .btn-primary:hover {
            background: #FFFFFF !important;
            color: #000000 !important;
            cursor: pointer;
        }
        .alert-danger {
            background: #FF0000 !important;
            color: #FFFFFF !important;
            border: 4px solid #FFFFFF !important;
            font-weight: 900;
            text-transform: uppercase;
            padding: 1.5rem;
            margin-bottom: 2.5rem;
            border-radius: 0;
        }
        .brand-logo { height: 100px; width: auto; margin-bottom: 40px; }
        .version-tag {
            color: #FF9F0A !important;
            font-weight: 900;
            font-size: 0.9rem;
            letter-spacing: 3px;
            margin-top: 40px;
            text-transform: uppercase;
            border-top: 2px solid rgba(255,255,255,0.2);
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <img src="/public/assets/logo.png" alt="Pikop Logo" class="brand-logo">

        <% if (locals.error) { %>
            <div class="alert alert-danger">🚨 <%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="mb-4 text-start">
                <label class="form-label">IDENTITY</label>
                <input type="text" name="username" class="form-control" required autocomplete="off" placeholder="USERNAME">
            </div>
            <div class="mb-5 text-start">
                <label class="form-label">SECURITY KEY</label>
                <input type="password" name="password" class="form-control" required placeholder="PASSWORD">
            </div>
            <button type="submit" class="btn btn-primary">AUTHORIZE SYSTEM ACCESS</button>
            <div class="version-tag">STABLE CORE v3.5.5 - HARDENED</div>
        </form>
    </div>
</body>
</html>
