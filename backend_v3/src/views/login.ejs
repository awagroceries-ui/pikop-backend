<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Pikop Command</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #000000 !important;
            color: #FFFFFF !important;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: sans-serif;
            margin: 0;
        }
        .login-card {
            background: #000000 !important;
            padding: 3.5rem;
            border-radius: 0;
            width: 100%;
            max-width: 420px;
            border: 4px solid #FF9F0A !important;
            box-shadow: 0 0 50px rgba(255, 159, 10, 0.2);
        }
        .form-control {
            background: #000000 !important;
            border: 2px solid #FFFFFF !important;
            color: #FFFFFF !important;
            padding: 1rem;
            font-weight: 900;
            border-radius: 0;
            font-size: 1.1rem;
        }
        .form-control:focus {
            border-color: #FF9F0A !important;
            box-shadow: none;
        }
        .form-label {
            color: #FFFFFF !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.9rem;
            letter-spacing: 2px;
            margin-bottom: 12px;
            display: block;
        }
        .btn-primary {
            background: #FF9F0A !important;
            border: none;
            color: #000000 !important;
            font-weight: 900;
            padding: 1.2rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            margin-top: 20px;
            border-radius: 0;
            width: 100%;
        }
        .btn-primary:hover {
            background: #FFFFFF !important;
            color: #000000 !important;
        }
        .alert-danger {
            background: #FF0000 !important;
            color: #FFFFFF !important;
            border: none;
            font-weight: 900;
            text-transform: uppercase;
            padding: 1rem;
            margin-bottom: 2rem;
        }
        .version-tag {
            color: #FF9F0A !important;
            font-weight: 900;
            font-size: 0.8rem;
            letter-spacing: 2px;
            margin-top: 30px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <h2 class="fw-black mb-5" style="color: #FFFFFF; letter-spacing: 4px;">PIKOP <span style="color: #FF9F0A;">COMMAND</span></h2>

        <% if (locals.error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="mb-4 text-start">
                <label class="form-label">USERNAME</label>
                <input type="text" name="username" class="form-control" required autocomplete="off">
            </div>
            <div class="mb-5 text-start">
                <label class="form-label">PASSWORD</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">AUTHORIZE SYSTEM ACCESS</button>
            <div class="version-tag">V3.5.5 - HIGH CONTRAST HARDENED</div>
        </form>
    </div>
</body>
</html>
