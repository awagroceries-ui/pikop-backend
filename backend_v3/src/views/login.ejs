<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Pikop Command</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --brand-black: #000000;
            --brand-gold: #FF9F0A;
            --brand-white: #FFFFFF;
        }
        body {
            background-color: var(--brand-black);
            color: var(--brand-white);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: sans-serif;
            margin: 0;
        }
        .login-card {
            background: #0A0A0A;
            padding: 3rem;
            border-radius: 24px;
            width: 100%;
            max-width: 400px;
            border: 2px solid var(--brand-gold);
            box-shadow: 0 0 20px rgba(255, 159, 10, 0.2);
        }
        .form-control {
            background: var(--brand-black) !important;
            border: 1px solid rgba(255,255,255,0.4) !important;
            color: var(--brand-white) !important;
            padding: 0.8rem;
            font-weight: 800;
        }
        .form-control:focus {
            border-color: var(--brand-gold) !important;
            box-shadow: none;
        }
        .form-label {
            color: var(--brand-white) !important;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 1.5px;
            margin-bottom: 8px;
        }
        .btn-primary {
            background: var(--brand-gold);
            border: none;
            color: var(--brand-black);
            font-weight: 900;
            padding: 0.9rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 10px;
        }
        .btn-primary:hover {
            background: #FFFFFF;
            color: var(--brand-black);
        }
        .alert-danger {
            background: #FF0000;
            color: #FFFFFF;
            border: none;
            font-weight: 900;
            text-transform: uppercase;
            font-size: 0.7rem;
            letter-spacing: 1px;
        }
        .meta-text {
            color: var(--brand-white);
            font-weight: 700;
            font-size: 0.7rem;
            letter-spacing: 1px;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <h3 class="fw-bold mb-4" style="color: var(--brand-white); letter-spacing: 2px;">PIKOP <span style="color: var(--brand-gold);">COMMAND</span></h3>

        <% if (locals.error) { %>
            <div class="alert alert-danger py-2 mb-4"><%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="mb-3 text-start">
                <label class="form-label">ADMIN USERNAME</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="mb-4 text-start">
                <label class="form-label">SECURE PASSWORD</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary w-100 mb-4">AUTHORIZE ACCESS</button>
            <p class="meta-text mb-0">V3.5.4 STABLE BASELINE</p>
        </form>
    </div>
</body>
</html>
