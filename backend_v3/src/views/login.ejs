<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PIKOP COMMAND | AUTHORIZED ACCESS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --green: #008751;
            --gold: #FFC618;
            --white: #FFFFFF;
            --black: #1A1A1A;
            --grey: #E0E0E0;
        }
        body {
            background-color: var(--white) !important;
            color: var(--black) !important;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', sans-serif;
            margin: 0;
        }
        .login-card {
            background: var(--white) !important;
            padding: 4rem 3rem;
            border-radius: 12px;
            width: 100%;
            max-width: 450px;
            border: 1px solid var(--grey) !important;
            box-shadow: 0 15px 50px rgba(0, 0, 0, 0.08);
        }
        .form-control {
            background: var(--white) !important;
            border: 1px solid var(--grey) !important;
            color: var(--black) !important;
            padding: 0.85rem 1.25rem;
            font-weight: 500;
            border-radius: 6px;
            font-size: 15px;
            transition: all 0.2s ease;
        }
        .form-control:focus {
            border-color: var(--green) !important;
            box-shadow: 0 0 0 4px rgba(0, 135, 81, 0.1) !important;
            outline: none;
        }
        .form-label {
            color: var(--black) !important;
            font-weight: 800;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 2px;
            margin-bottom: 12px;
            display: block;
            opacity: 0.8;
        }
        .btn-primary {
            background: var(--green) !important;
            border: none;
            color: var(--white) !important;
            font-weight: 800;
            padding: 1rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-top: 25px;
            border-radius: 6px;
            width: 100%;
            font-size: 14px;
            box-shadow: 0 4px 12px rgba(0, 135, 81, 0.2);
            transition: all 0.2s ease;
        }
        .btn-primary:hover {
            background: #006b3f !important;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 135, 81, 0.3);
        }
        .alert-danger {
            background: #FF6900 !important;
            color: var(--white) !important;
            border: none;
            font-weight: 700;
            font-size: 13px;
            padding: 15px;
            margin-bottom: 2.5rem;
            border-radius: 6px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .brand-logo { height: 50px; width: auto; margin-bottom: 35px; }
        .version-tag {
            color: var(--black) !important;
            font-weight: 600;
            font-size: 10px;
            letter-spacing: 2px;
            margin-top: 40px;
            opacity: 0.4;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <img src="/public/assets/logo.png" alt="Pikop Logo" class="brand-logo">
        <div style="font-size: 13px; font-weight: 800; color: var(--green); letter-spacing: 3px; margin-bottom: 45px; text-transform: uppercase;">ADMIN COMMAND CENTER</div>

        <% if (locals.error) { %>
            <div class="alert alert-danger">Access Denied: <%= error %></div>
        <% } %>

        <form action="/admin/login" method="POST">
            <div class="mb-4 text-start">
                <label class="form-label">OPERATOR USERNAME</label>
                <input type="text" name="username" class="form-control" required autocomplete="off">
            </div>
            <div class="mb-5 text-start">
                <label class="form-label">SECURITY PASSWORD</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">AUTHORIZE ACCESS</button>
            <div class="version-tag">STABLE CORE v3.5.7</div>
        </form>
    </div>
</body>
</html>
