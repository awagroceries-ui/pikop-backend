<div class="mb-5 d-flex align-items-center gap-3">
    <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 32px; width: auto;">
    <div>
        <h3 class="fw-bold mb-0 text-white" style="letter-spacing: -0.5px;">Mission Control</h3>
        <p class="text-white opacity-50 small mb-0">System-wide operational oversight.</p>
    </div>
</div>

<!-- KPI Row -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card-pikop p-4">
            <div class="text-gold fw-bold smaller uppercase mb-2" style="font-size: 11px; letter-spacing: 1px;">Live Missions</div>
            <div class="d-flex align-items-baseline gap-2">
                <h3 class="mb-0 fw-bold text-white mono"><%= stats.activeOrders %></h3>
                <div class="rounded-circle bg-green" style="width: 6px; height: 6px;"></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-pikop p-4">
            <div class="text-gold fw-bold smaller uppercase mb-2" style="font-size: 11px; letter-spacing: 1px;">Online Fleet</div>
            <h3 class="mb-0 fw-bold text-white mono"><%= stats.onlineFulfillers %></h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-pikop p-4">
            <div class="text-gold fw-bold smaller uppercase mb-2" style="font-size: 11px; letter-spacing: 1px;">Gross Revenue (24h)</div>
            <h3 class="mb-0 fw-bold text-white mono">₦<%= stats.totalRevenue.toLocaleString() %></h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card-pikop p-4 border-gold">
            <div class="text-gold fw-bold smaller uppercase mb-2" style="font-size: 11px; letter-spacing: 1px;">System Baseline</div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-gold text-black fw-bold" style="font-size: 10px;">V3.5.7</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Graph -->
    <div class="col-md-8">
        <div class="card-pikop p-4">
            <h6 class="text-white fw-bold uppercase mb-4" style="font-size: 12px; letter-spacing: 1px;">Performance Trends</h6>
            <!-- TERMINAL GRAPH FIX -->
            <div style="height: 300px !important; width: 100%; position: relative; overflow: hidden; box-sizing: border-box;">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Alert Queue -->
    <div class="col-md-4">
        <div class="card-pikop p-4 h-100">
            <h6 class="text-white fw-bold uppercase mb-4" style="font-size: 12px; letter-spacing: 1px;">Critical Alerts</h6>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 d-flex justify-content-between align-items-center bg-black border border-white border-opacity-10">
                    <span class="text-white small fw-bold">PENDING KYC</span>
                    <span class="badge bg-red text-white fw-bold px-3"><%= stats.notifications.kyc %></span>
                </div>
                <div class="p-3 d-flex justify-content-between align-items-center bg-black border border-white border-opacity-10">
                    <span class="text-white small fw-bold">OPEN TICKETS</span>
                    <span class="badge bg-gold text-black fw-bold px-3"><%= stats.notifications.support %></span>
                </div>
            </div>

            <div class="mt-5">
                <button class="btn-pikop-outline w-100 py-2" onclick="window.location.href='/admin/reports'">VIEW FULL ANALYTICS</button>
            </div>
        </div>
    </div>
</div>

<script>
    const ctx = document.getElementById('performanceChart').getContext('2d');

    // Safety: Reset chart on load
    if (window.pikopChart) window.pikopChart.destroy();

    window.pikopChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Day 1', 'Day 2', 'Day 3', 'Day 4', 'Day 5', 'Day 6', 'Day 7'],
            datasets: [
                {
                    label: 'LOGISTICS',
                    data: [0, 0, 0, 0, 0, 0, 10],
                    borderColor: '#FF5722',
                    backgroundColor: 'rgba(255, 87, 34, 0.05)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 2
                },
                {
                    label: 'MARKETPLACE',
                    data: [0, 0, 0, 0, 0, 0, 5],
                    borderColor: '#34C759',
                    backgroundColor: 'rgba(52, 199, 89, 0.05)',
                    fill: true,
                    tension: 0.3,
                    borderWidth: 2
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            animation: false,
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: '#222' },
                    ticks: { color: '#FFF', font: { size: 10, weight: '600' } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#FFF', font: { size: 10, weight: '600' } }
                }
            },
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: { color: '#FFF', font: { size: 11, weight: '600' }, padding: 15 }
                }
            }
        }
    });

    async function refreshChart() {
        try {
            const res = await fetch('/admin/reports/api/performance?days=7');
            const json = await res.json();
            if (json.success) {
                const data = json.data;
                window.pikopChart.data.datasets[0].data[6] = data.pickup_delivery.volume;
                window.pikopChart.data.datasets[1].data[6] = data.marketplace.volume;
                window.pikopChart.update();
            }
        } catch (e) {}
    }

    window.onload = refreshChart;
</script>

<style>
    .text-gold { color: var(--gold) !important; }
    .bg-green { background-color: var(--green) !important; }
    .bg-red { background-color: var(--red) !important; }
    .border-gold { border-color: var(--gold) !important; }
</style>
