<div class="mb-5 d-flex align-items-center gap-4">
    <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 60px; width: auto;">
    <div>
        <h1 class="fw-black mb-0 text-white" style="letter-spacing: 2px;">MISSION CONTROL</h1>
        <p class="text-white opacity-75 fw-bold mb-0">Live operational overview across all modules.</p>
    </div>
</div>

<!-- KPI Row (High Contrast) -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="p-4" style="background: #000; border: 3px solid #FFF;">
            <div class="text-primary fw-black smaller uppercase ls-1 mb-2">Active Missions</div>
            <h2 class="mb-0 fw-black text-white"><%= stats.activeOrders %></h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-4" style="background: #000; border: 3px solid #FFF;">
            <div class="text-primary fw-black smaller uppercase ls-1 mb-2">Fleet Online</div>
            <h2 class="mb-0 fw-black text-white"><%= stats.onlineFulfillers %></h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-4" style="background: #000; border: 3px solid #FFF;">
            <div class="text-primary fw-black smaller uppercase ls-1 mb-2">Revenue (24h)</div>
            <h2 class="mb-0 fw-black text-white">₦<%= stats.totalRevenue.toLocaleString() %></h2>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-4" style="background: #FF9F0A; border: 3px solid #FFF;">
            <div class="text-black fw-black smaller uppercase ls-1 mb-2">System Status</div>
            <h2 class="mb-0 fw-black text-black">V3.5.5</h2>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Graph Container -->
    <div class="col-md-8">
        <div style="background: #000; border: 3px solid #FFF; padding: 2rem;">
            <h4 class="text-white fw-black mb-4 ls-1">VOLUME PERFORMANCE</h4>
            <!-- HARD LOCK ON HEIGHT TO PREVENT STRETCHING -->
            <div style="height: 350px !important; width: 100%; position: relative;">
                <canvas id="performanceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Alert Queue -->
    <div class="col-md-4">
        <div style="background: #000; border: 3px solid #FFF; padding: 2rem; height: 100%;">
            <h4 class="text-white fw-black mb-4 ls-1">CRITICAL QUEUE</h4>

            <div class="d-flex flex-column gap-3">
                <div class="p-3 d-flex justify-content-between align-items-center" style="border: 2px solid #FF0000; background: rgba(255,0,0,0.1);">
                    <span class="text-white fw-black">PENDING KYC</span>
                    <span class="badge bg-danger text-white fw-black px-3"><%= stats.notifications.kyc %></span>
                </div>
                <div class="p-3 d-flex justify-content-between align-items-center" style="border: 2px solid #FF9F0A; background: rgba(255,159,10,0.1);">
                    <span class="text-white fw-black">OPEN TICKETS</span>
                    <span class="badge bg-warning text-black fw-black px-3"><%= stats.notifications.support %></span>
                </div>
            </div>

            <div class="mt-5">
                <button class="btn btn-primary w-100 fw-black py-3 ls-1" onclick="window.location.href='/admin/reports'">VIEW ANALYTICS HUB</button>
            </div>
        </div>
    </div>
</div>

<script>
    const ctx = document.getElementById('performanceChart').getContext('2d');

    // Explicitly destroy existing chart if it exists
    if (window.pikopChart) window.pikopChart.destroy();

    window.pikopChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['D1', 'D2', 'D3', 'D4', 'D5', 'D6', 'D7'],
            datasets: [
                {
                    label: 'LOGISTICS',
                    data: [0, 0, 0, 0, 0, 0, 10],
                    borderColor: '#FF5722',
                    backgroundColor: 'rgba(255, 87, 34, 0.2)',
                    fill: true,
                    tension: 0.3
                },
                {
                    label: 'MARKETPLACE',
                    data: [0, 0, 0, 0, 0, 0, 5],
                    borderColor: '#8BC34A',
                    backgroundColor: 'rgba(139, 195, 74, 0.2)',
                    fill: true,
                    tension: 0.3
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(255,255,255,0.1)' },
                    ticks: { color: '#FFFFFF', font: { weight: 'bold' } }
                },
                x: {
                    grid: { display: false },
                    ticks: { color: '#FFFFFF', font: { weight: 'bold' } }
                }
            },
            plugins: {
                legend: { labels: { color: '#FFFFFF', font: { weight: 'bold' } } }
            }
        }
    });

    // Handle Resize Stability
    window.addEventListener('resize', () => {
        window.pikopChart.resize();
    });
</script>
