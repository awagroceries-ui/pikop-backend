<div class="mb-5">
    <h4 class="mb-1 fw-black text-white ls-1">PLATFORM PROTOCOLS</h4>
    <p class="text-white opacity-75 small fw-bold mb-0">Adjust global market variables and operational constraints.</p>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card border-white border-opacity-25 p-4" style="background: #0A0A0A;">
            <h5 class="card-title text-primary mb-4 fw-black ls-1">Fare Pricing Dynamics (NGN)</h5>
            <hr class="border-white opacity-10">

            <form action="/admin/settings" method="POST" class="mt-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label smaller fw-black text-white uppercase ls-1">Base (SMALL)</label>
                        <input type="number" name="base_fare_small" class="form-control bg-black border-white border-opacity-25 text-white fw-black mono" value="<%= settings.base_fare_small %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label smaller fw-black text-white uppercase ls-1">Base (MEDIUM)</label>
                        <input type="number" name="base_fare_medium" class="form-control bg-black border-white border-opacity-25 text-white fw-black mono" value="<%= settings.base_fare_medium %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label smaller fw-black text-white uppercase ls-1">Base (LARGE)</label>
                        <input type="number" name="base_fare_large" class="form-control bg-black border-white border-opacity-25 text-white fw-black mono" value="<%= settings.base_fare_large %>" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-black text-white uppercase ls-1">Distance Rate (Per KM)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black border-white border-opacity-25 text-white fw-black">₦</span>
                        <input type="number" name="per_km_rate" class="form-control bg-black border-white border-opacity-25 text-white fw-black mono" value="<%= settings.per_km_rate %>" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-black text-white uppercase ls-1">Platform Commission</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="platform_commission" class="form-control bg-black border-white border-opacity-25 text-white fw-black mono" value="<%= settings.platform_commission %>" required>
                        <span class="input-group-text bg-black border-white border-opacity-25 text-white fw-black">% Decimal</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary px-5 py-2 fw-black ls-1">COMMIT PLATFORM CHANGES</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card border-white border-opacity-25 p-4 h-100" style="background: #0A0A0A;">
            <h5 class="card-title text-white mb-4 fw-black ls-1">Core Environment</h5>
            <hr class="border-white opacity-10">

            <div class="d-flex flex-column gap-3 mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-bold">API Version</span>
                    <span class="badge bg-primary text-black fw-black mono">v3.5.3-STABLE</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-bold">Server Tier</span>
                    <span class="text-white small fw-black">4GB VPS (HARDENED)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-bold">Storage Layer</span>
                    <span class="text-white small mono fw-bold">PostgreSQL 16.2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.7rem; }
    .form-control:focus { background-color: #000; color: #fff; border-color: var(--brand-gold); box-shadow: none; }
    .input-group-text { border-right: none; }
    input { border-left: none; }
</style>
