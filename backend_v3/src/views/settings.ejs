<div class="mb-5">
    <h4 class="mb-1 fw-black text-white ls-1">PLATFORM PROTOCOLS</h4>
    <p class="text-white opacity-75 small fw-bold mb-0">Adjust global market variables and operational constraints.</p>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card p-5" style="background: #000; border: 3px solid #FFF;">
            <h5 class="card-title text-primary mb-4 fw-black ls-1" style="color: var(--gold) !important;">FARE PRICING DYNAMICS (NGN)</h5>
            <hr class="border-white opacity-20 mb-5">

            <form action="/admin/settings" method="POST" class="mt-4">
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label class="form-label text-white fw-black smaller ls-1">BASE (SMALL)</label>
                        <input type="number" name="base_fare_small" class="form-control bg-black border-white text-white fw-black mono py-3" value="<%= settings.base_fare_small %>" required style="border-radius: 0; border-width: 2px;">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-white fw-black smaller ls-1">BASE (MEDIUM)</label>
                        <input type="number" name="base_fare_medium" class="form-control bg-black border-white text-white fw-black mono py-3" value="<%= settings.base_fare_medium %>" required style="border-radius: 0; border-width: 2px;">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-white fw-black smaller ls-1">BASE (LARGE)</label>
                        <input type="number" name="base_fare_large" class="form-control bg-black border-white text-white fw-black mono py-3" value="<%= settings.base_fare_large %>" required style="border-radius: 0; border-width: 2px;">
                    </div>
                </div>

                <div class="mb-5">
                    <label class="form-label text-white fw-black smaller ls-1">DISTANCE RATE (PER KM)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-black border-white text-white fw-black">₦</span>
                        <input type="number" name="per_km_rate" class="form-control bg-black border-white text-white fw-black mono py-3" value="<%= settings.per_km_rate %>" required style="border-radius: 0; border-width: 2px;">
                    </div>
                </div>

                <div class="mb-5">
                    <label class="form-label text-white fw-black smaller ls-1">PLATFORM COMMISSION</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="platform_commission" class="form-control bg-black border-white text-white fw-black mono py-3" value="<%= settings.platform_commission %>" required style="border-radius: 0; border-width: 2px;">
                        <span class="input-group-text bg-black border-white text-white fw-black">% DECIMAL</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary px-5 py-3 fw-black ls-1 w-100">COMMIT PLATFORM CHANGES</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card p-5 h-100" style="background: #000; border: 3px solid #FFF;">
            <h5 class="card-title text-white mb-4 fw-black ls-1">CORE ENVIRONMENT</h5>
            <hr class="border-white opacity-20 mb-5">

            <div class="d-flex flex-column gap-4 mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-black">API VERSION</span>
                    <span class="badge bg-primary text-black fw-black mono px-3">v3.5.6-STABLE</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-black">SERVER TIER</span>
                    <span class="text-white small fw-black">4GB VPS (HARDENED)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-white opacity-75 small fw-black">STORAGE LAYER</span>
                    <span class="text-white small mono fw-black">POSTGRESQL 16.2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus { background-color: #000; color: #fff; border-color: var(--gold); box-shadow: 0 0 10px var(--gold); }
    .input-group-text { border-width: 2px; }
</style>
