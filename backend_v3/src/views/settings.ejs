<div class="mb-5">
    <h4 class="fw-bold mb-1 text-black">System Configuration</h4>
    <p class="text-muted small mb-0">Global market variables and operational constraints.</p>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card-pikop p-5">
            <h6 class="text-black small fw-bold uppercase mb-4" style="letter-spacing: 1px;">Pricing Dynamics (NGN)</h6>
            <hr class="mb-5">

            <form action="/admin/settings" method="POST">
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">BASE (SMALL)</label>
                        <input type="number" name="base_fare_small" class="form-control py-2" value="<%= settings.base_fare_small %>" required style="border-radius: 6px;">
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">BASE (MEDIUM)</label>
                        <input type="number" name="base_fare_medium" class="form-control py-2" value="<%= settings.base_fare_medium %>" required style="border-radius: 6px;">
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">BASE (LARGE)</label>
                        <input type="number" name="base_fare_large" class="form-control py-2" value="<%= settings.base_fare_large %>" required style="border-radius: 6px;">
                    </div>
                </div>

                <div class="mb-5">
                    <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">DISTANCE RATE (PER KM)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold">₦</span>
                        <input type="number" name="per_km_rate" class="form-control py-2" value="<%= settings.per_km_rate %>" required style="border-radius: 0 6px 6px 0;">
                    </div>
                </div>

                <h6 class="text-black small fw-bold uppercase mt-5 mb-4" style="letter-spacing: 1px;">Buyer-Borne Fees</h6>
                <hr class="mb-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">COD PROTECTION FEE (%)</label>
                        <div class="input-group">
                            <input type="number" step="0.01" name="cod_fee_rate" class="form-control py-2" value="<%= settings.cod_fee_rate %>" required>
                            <span class="input-group-text bg-light fw-bold">% DEC</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">GUEST SMS CHARGE (₦)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₦</span>
                            <input type="number" name="guest_sms_charge" class="form-control py-2" value="<%= settings.guest_sms_charge %>" required>
                        </div>
                    </div>
                </div>
                <p class="smaller text-muted mb-5"><i>Applied to new orders only. Existing orders frozen at creation.</i></p>

                <h6 class="text-black small fw-bold uppercase mt-5 mb-4" style="letter-spacing: 1px;">Merchant-Borne Commissions</h6>
                <hr class="mb-4">
                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">FOOD (%)</label>
                        <input type="number" step="0.01" name="food_commission" class="form-control py-2" value="<%= settings.food_commission %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">GROCERIES (%)</label>
                        <input type="number" step="0.01" name="groceries_commission" class="form-control py-2" value="<%= settings.groceries_commission %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">SHOP (%)</label>
                        <input type="number" step="0.01" name="shop_commission" class="form-control py-2" value="<%= settings.shop_commission %>" required>
                    </div>
                </div>
                <p class="smaller text-muted mb-5"><i>Deducted from merchant payouts on Marketplace sales.</i></p>

                <h6 class="text-black small fw-bold uppercase mt-5 mb-4" style="letter-spacing: 1px;">Fulfiller-Borne Commission</h6>
                <hr class="mb-4">
                <div class="mb-4">
                    <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">DISPATCH COMMISSION (%)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="platform_commission" class="form-control py-2" value="<%= settings.platform_commission %>" required>
                        <span class="input-group-text bg-light fw-bold">% DEC</span>
                    </div>
                </div>
                <p class="smaller text-muted mb-5"><i>Pikop share of delivery fee. Fulfiller receives the remaining balance.</i></p>

                <h6 class="text-black small fw-bold uppercase mt-5 mb-4" style="letter-spacing: 1px;">Pricing Enhancements (v4.3)</h6>
                <hr class="mb-4">

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Max Surge Multiplier</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">X</span>
                            <input type="number" step="0.1" name="max_surge_multiplier" class="form-control py-2" value="<%= settings.max_surge_multiplier %>" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Manual Surge Override</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">X</span>
                            <input type="number" step="0.1" name="manual_surge_multiplier" class="form-control py-2" value="<%= settings.manual_surge_multiplier %>" required>
                        </div>
                    </div>
                </div>
                <p class="smaller text-muted mb-4"><i>Surge is automatically calculated via demand/supply ratio but capped at Max Surge. Manual Override forces surge to at least the specified value (Default: 1.0).</i></p>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Insurance Rate (DEC)</label>
                        <div class="input-group">
                            <input type="number" step="0.01" name="insurance_rate" class="form-control py-2" value="<%= settings.insurance_rate %>" required>
                            <span class="input-group-text bg-light fw-bold">%</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Insurance Min Item Value</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₦</span>
                            <input type="number" name="insurance_min_item_value" class="form-control py-2" value="<%= settings.insurance_min_item_value %>" required>
                        </div>
                    </div>
                </div>
                <p class="smaller text-muted mb-5"><i>Items above the minimum value will be offered optional protection at checkout.</i></p>

                <h6 class="text-black small fw-bold uppercase mt-5 mb-4" style="letter-spacing: 1px;">Growth & Incentives (v4.4)</h6>
                <hr class="mb-4">

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">7-Day Streak Bonus</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₦</span>
                            <input type="number" step="1" name="streak_bonus_7_day" class="form-control py-2" value="<%= settings.streak_bonus_7_day %>" required>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">30-Day Streak Bonus</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₦</span>
                            <input type="number" step="1" name="streak_bonus_30_day" class="form-control py-2" value="<%= settings.streak_bonus_30_day %>" required>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Peak Hour Start</label>
                        <input type="time" name="peak_hour_start" class="form-control py-2" value="<%= settings.peak_hour_start %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Peak Hour End</label>
                        <input type="time" name="peak_hour_end" class="form-control py-2" value="<%= settings.peak_hour_end %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="text-black small fw-bold uppercase mb-2 d-block" style="font-size: 11px;">Peak Bonus / Order</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₦</span>
                            <input type="number" step="1" name="peak_hour_bonus" class="form-control py-2" value="<%= settings.peak_hour_bonus %>" required>
                        </div>
                    </div>
                </div>
                <p class="smaller text-muted mb-5"><i>Peak hour bonuses are paid from the Platform Wallet to encourage online presence during high demand.</i></p>

                <div class="alert alert-warning border-0 small py-3 mb-5" style="border-radius: 12px;">
                    <div class="fw-bold mb-1">⚠️ Policy Enforcement Notice</div>
                    Rate changes will apply to <b>new orders/missions created after saving</b>. Active missions will complete using the rates they were assigned at creation.
                </div>

                <button type="submit" class="btn-pikop-primary w-100 py-3">SAVE SYSTEM PROTOCOLS</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card-pikop p-5 h-100">
            <h6 class="text-black small fw-bold uppercase mb-4" style="letter-spacing: 1px;">Core Environment</h6>
            <hr class="mb-5">

            <div class="d-flex flex-column gap-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold">API VERSION</span>
                    <span class="badge bg-light text-black border fw-bold">3.5.7-STABLE</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold">SERVER TIER</span>
                    <span class="text-black fw-bold">4GB VPS (OPTIMIZED)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small fw-bold">STORAGE LAYER</span>
                    <span class="text-black fw-bold">PG-16.2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .input-group-text { border: 1px solid var(--border); border-right: none; }
</style>
