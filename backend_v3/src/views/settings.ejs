<div class="mb-5">
    <h4 class="mb-1">Platform Protocols</h4>
    <p class="text-muted small mb-0">Adjust global market variables and operational constraints.</p>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card bg-card border-0 p-4">
            <h5 class="card-title text-primary mb-4 fw-bold ls-1">Fare Pricing Dynamics (NGN)</h5>
            <hr class="border-secondary opacity-10">

            <form action="/admin/settings" method="POST" class="mt-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label smaller fw-bold text-muted uppercase ls-1">Base (SMALL)</label>
                        <input type="number" name="base_fare_small" class="form-control bg-dark border-secondary text-white mono" value="<%= settings.base_fare_small %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label smaller fw-bold text-muted uppercase ls-1">Base (MEDIUM)</label>
                        <input type="number" name="base_fare_medium" class="form-control bg-dark border-secondary text-white mono" value="<%= settings.base_fare_medium %>" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label smaller fw-bold text-muted uppercase ls-1">Base (LARGE)</label>
                        <input type="number" name="base_fare_large" class="form-control bg-dark border-secondary text-white mono" value="<%= settings.base_fare_large %>" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted uppercase ls-1">Distance Rate (Per KM)</label>
                    <div class="input-group">
                        <span class="input-group-text bg-dark border-secondary text-muted">₦</span>
                        <input type="number" name="per_km_rate" class="form-control bg-dark border-secondary text-white mono" value="<%= settings.per_km_rate %>" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted uppercase ls-1">Platform Commission</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="platform_commission" class="form-control bg-dark border-secondary text-white mono" value="<%= settings.platform_commission %>" required>
                        <span class="input-group-text bg-dark border-secondary text-muted">% Decimal</span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary px-5 py-2 fw-black ls-1">COMMIT PLATFORM CHANGES</button>
            </form>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card bg-card border-0 p-4 h-100">
            <h5 class="card-title text-active mb-4 fw-bold ls-1">Core Environment</h5>
            <hr class="border-secondary opacity-10">

            <div class="d-flex flex-column gap-3 mt-4">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">API Version</span>
                    <span class="badge bg-primary text-black mono">v3.0.0-STABLE</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Server Tier</span>
                    <span class="text-white small fw-bold">4GB VPS (OPTIMIZED)</span>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted small">Storage Layer</span>
                    <span class="text-white small mono">PostgreSQL 16.2</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .smaller { font-size: 0.7rem; }
</style>
