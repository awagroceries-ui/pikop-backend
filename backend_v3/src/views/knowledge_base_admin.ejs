<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>AI Knowledge Base & FAQs</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addArticleModal">
        + Add Knowledge Article
    </button>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Audience</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (articles.length === 0) { %>
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No knowledge base articles found.</td>
                        </tr>
                    <% } else { %>
                        <% articles.forEach(article => { %>
                            <tr>
                                <td>
                                    <strong><%= article.title %></strong>
                                    <div class="small text-muted"><%= article.content.length > 80 ? article.content.substring(0, 80) + '...' : article.content %></div>
                                </td>
                                <td><span class="badge bg-secondary"><%= article.category %></span></td>
                                <td><span class="badge bg-info text-dark"><%= article.target_audience %></span></td>
                                <td><%= article.priority %></td>
                                <td>
                                    <span class="badge bg-<%= article.is_active ? 'success' : 'danger' %>">
                                        <%= article.is_active ? 'ACTIVE' : 'INACTIVE' %>
                                    </span>
                                </td>
                                <td>
                                    <form action="/admin/knowledge-base/<%= article.id %>/toggle" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-<%= article.is_active ? 'warning' : 'success' %>">
                                            <%= article.is_active ? 'Deactivate' : 'Activate' %>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal: Add Article -->
<div class="modal fade" id="addArticleModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form action="/admin/knowledge-base" method="POST">
                <div class="modal-header">
                    <h5 class="modal-title">Add Knowledge Base Article</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Title / Question</label>
                        <input type="text" name="title" class="form-control" required placeholder="e.g. How does Cash on Delivery Escrow work?">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Answer / Content</label>
                        <textarea name="content" class="form-control" rows="5" required placeholder="Detailed answer used by the Pikop AI Agent..."></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Category</label>
                            <select name="category" class="form-select">
                                <option value="GENERAL">General</option>
                                <option value="PAYMENTS">Payments & Escrow</option>
                                <option value="LOGISTICS">Logistics & Tracking</option>
                                <option value="COMMERCE">Marketplace & Food</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Target Audience</label>
                            <select name="target_audience" class="form-select">
                                <option value="BOTH">Both (Customer & Fulfiller)</option>
                                <option value="CUSTOMER">Customer Only</option>
                                <option value="FULFILLER">Fulfiller Only</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Priority (Higher = First)</label>
                            <input type="number" name="priority" class="form-control" value="0">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Article</button>
                </div>
            </form>
        </div>
    </div>
</div>
