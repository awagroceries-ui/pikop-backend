<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Pikop Logistics</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #F3F4F6; color: #1F2937; padding: 40px 20px; }
        .container { max-width: 800px; background: #ffffff; padding: 60px; border-radius: 24px; box-shadow: 0 10px 25px rgba(0,0,0,0.05); }
        h1, h2, h3 { color: #008751; font-weight: 800; }
        .text { line-height: 1.8; margin-bottom: 20px; }
        @media (max-width: 600px) { .container { padding: 30px 20px; border-radius: 0; } }
    </style>
</head>
<body>
    <div class="container">
        <div class="text-center mb-5">
            <img src="/public/assets/logo.png" alt="Pikop Logo" style="height: 50px;">
        </div>
        <%- body %>
        <div class="mt-5 pt-4 border-top text-center text-muted small">
            &copy; 2026 Pikop Logistics Limited. All rights reserved.
        </div>
    </div>
</body>
</html>